% Durable equations receive editorial numbering in the modern and flowing
% editions; the facsimile style suppresses that numbering.
\numberwithin{equation}{chapter}
\NewDocumentEnvironment{waveequation}{}{\begin{equation}}{\end{equation}}
\NewDocumentEnvironment{wavealign}{}{\begin{equation}\begin{aligned}}{\end{aligned}\end{equation}}
\NewDocumentCommand{\wavefiguremark}{}{%
	\refstepcounter{figure}%
	\par\nobreak\smallskip
	\noindent\hfill{\small\sffamily Figure \thefigure}\hfill\null\par
	\smallskip
}

% Source-page counters record source pages. Flowing editions ignore them; the
% facsimile style gives this command page-boundary semantics.
\NewDocumentCommand{\sourcesetpage}{m}{}

% Build identity is generated under build/ while direct TeX compilation remains
% usable without the repository build wrapper.
\IfFileExists{../build/build-info.tex}{%
	\input{../build/build-info.tex}%
}{%
	\providecommand{\wavebuildsha}{unknown}%
	\providecommand{\wavebuildshort}{unknown}%
	\providecommand{\wavebuildversion}{}%
	\providecommand{\wavebuildlabel}{unknown}%
	\providecommand{\wavebuildurl}{https://github.com/mwyau/wave-motions-in-the-ocean}%
}
\AtBeginDocument{%
	\hypersetup{%
		pdfsubject={Digital edition build \wavebuildlabel},%
		pdfkeywords={Wave Motions in the Ocean, digital edition, build \wavebuildshort}%
	}%
}

% Shared semantic markup also drives generated HTML/EPUB transformations.
\NewDocumentCommand{\wavesignature}{m m m}{%
	\par\medskip
	\begin{flushright}
		\textit{#1}\\
		#2, #3
	\end{flushright}
}

\makeatletter

% Direct crop from a source PDF: width, filename, physical page,
% and trim rectangle. A trailing slash-delimited mask is optional; its four
% values are absolute PDF page coordinates in bp, ordered x0/y0/x1/y1.
\newsavebox{\wavesourceartbox}
\NewDocumentCommand{\sourceart}{O{0.72} m m m o}{%
	\par\smallskip
	\begin{center}
		\IfNoValueTF{#5}{%
			\includegraphics[page=#3,trim=#4,clip,width=#1\linewidth]{../references/chapman-rizzoli-1989/#2}%
		}{%
			\sbox{\wavesourceartbox}{%
				\includegraphics[page=#3,trim=#4,clip,width=#1\linewidth]{../references/chapman-rizzoli-1989/#2}%
			}%
			\def\waveparsecrop##1bp ##2bp ##3bp ##4bp\relax{%
				\def\waveleft{##1}%
				\def\wavebottom{##2}%
				\def\waveright{##3}%
				\def\wavetop{##4}%
			}%
			\expandafter\waveparsecrop#4\relax
			\def\waveparsemask##1/##2/##3/##4\relax{%
				\def\wavemaskxzero{##1}%
				\def\wavemaskyzero{##2}%
				\def\wavemaskxone{##3}%
				\def\wavemaskyone{##4}%
			}%
			\expandafter\waveparsemask#5\relax
			\pgfmathsetmacro{\wavebppt}{72.27/72}
			\pgfmathsetmacro{\wavecropwidth}{606.72-\waveleft-\waveright}
			\pgfmathsetmacro{\wavecropheight}{791.04-\wavebottom-\wavetop}
			\pgfmathsetmacro{\wavesourceartscale}{%
				(\strip@pt\wd\wavesourceartbox)/(\wavecropwidth*\wavebppt)%
			}
			\pgfmathsetmacro{\wavemaskxzero}{%
				(\wavemaskxzero-\waveleft)*\wavebppt*\wavesourceartscale%
			}
			\pgfmathsetmacro{\wavemaskyzero}{%
				(\wavemaskyzero-\wavebottom)*\wavebppt*\wavesourceartscale%
			}
			\pgfmathsetmacro{\wavemaskxone}{%
				(\wavemaskxone-\waveleft)*\wavebppt*\wavesourceartscale%
			}
			\pgfmathsetmacro{\wavemaskyone}{%
				(\wavemaskyone-\wavebottom)*\wavebppt*\wavesourceartscale%
			}
			\begin{tikzpicture}[x=1pt,y=1pt]
				\node[anchor=south west,inner sep=0] at (0,0) {\usebox{\wavesourceartbox}};
				\fill[white] (\wavemaskxzero,\wavemaskyzero) rectangle (\wavemaskxone,\wavemaskyone);
			\end{tikzpicture}%
		}%
	\end{center}
	\wavefiguremark
	\smallskip
}

% The requested width scales only TikZ geometry. Labels keep one physical
% \small size, and line weights/arrowheads are not scaled with the picture.
\newsavebox{\wavevectorbox}
\NewDocumentCommand{\wavevectorart}{O{0.72} m}{%
	\par\smallskip
	\begin{center}
		\begingroup
		\let\par\relax
		\let\smallskip\relax
		\def\center{}%
		\def\endcenter{}%
		\sbox{\wavevectorbox}{%
			\begingroup
			\small
			\input{figures/#2.tikz}%
			\endgroup
		}%
		\pgfmathsetmacro{\wavevectorscale}{%
			0.975*(#1*\strip@pt\linewidth)/(\strip@pt\wd\wavevectorbox)%
		}%
		\tikzset{every picture/.append style={scale=\wavevectorscale}}%
		\small
		\input{figures/#2.tikz}%
		\endgroup
	\end{center}
	\wavefiguremark
	\smallskip
}
\makeatother

