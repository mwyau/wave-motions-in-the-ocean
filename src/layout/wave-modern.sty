\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{layout/wave-modern}[2026/08/22 LuaLaTeX/STIX Two modern reading layout]
\RequirePackage{layout/wave-common}
% The modern paged edition uses a 7 x 10 in book trim; the facsimile stays Letter.
\RequirePackage[paperwidth=7in,paperheight=10in,top=0.70in,bottom=0.72in,left=0.75in,right=0.75in,headsep=0.22in]{geometry}
\RequirePackage{titlesec}
\RequirePackage{comment}
\RequirePackage{float}
\RequirePackage{fancyhdr}
\newfontfamily\WaveCoverHeadline{STIX Two Text SemiBold}[Ligatures=TeX,LetterSpace=1.5]

% PDF and flowing reader front matter share one source.
\includecomment{wavepdfonly}
\excludecomment{wavewebonly}
\excludecomment{waveepubonly}

\definecolor{WaveAccent}{HTML}{245A73}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0.18em plus 0.05em minus 0.03em}
\setlength{\jot}{7pt}
\setlength{\headheight}{22pt}
\raggedbottom

\titleformat{\chapter}[display]
{\normalfont\sffamily\color{WaveAccent}}
{\fontsize{14.5pt}{17pt}\selectfont\bfseries Chapter \thechapter}
{0.32em}
{\fontsize{29pt}{31pt}\selectfont\bfseries}
[\vspace{0.25em}\titlerule]
\titlespacing*{\chapter}{0pt}{0.2in}{0.38in}
\titleformat{\section}
{\fontsize{16.5pt}{19.5pt}\selectfont\sffamily\bfseries\color{WaveAccent}}
{\thesection}{0.65em}{}
\titlespacing*{\section}{0pt}{1.25em plus .2em minus .1em}{0.50em}
\titleformat{\subsection}
{\fontsize{13.5pt}{16pt}\selectfont\sffamily\bfseries\color{WaveAccent}}
{\thesubsection}{0.55em}{}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{WaveAccent} Wave Motions in the Ocean}
\fancyhead[R]{\small\sffamily\color{WaveAccent}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{WaveAccent}\leaders\hrule height \headrulewidth\hfill}}

% A verso inserted solely to move the next chapter to recto is completely blank.
\RenewDocumentCommand{\cleardoublepage}{}{%
	\clearpage
	\ifodd\value{page}\else
		\begingroup
		\pagestyle{empty}%
		\thispagestyle{empty}%
		\null
		\newpage
		\endgroup
	\fi
}

\AtBeginDocument{%
	% Chapter/section commands invoke \normalsize, so the reading size must be
	% part of \normalsize rather than a one-time document setting.
	\let\WaveClassNormalSize\normalsize
	\renewcommand{\normalsize}{%
		\WaveClassNormalSize
		\fontsize{11.5pt}{14.2pt}\selectfont
		\setlength{\abovedisplayskip}{11pt plus 3pt minus 3pt}%
		\setlength{\belowdisplayskip}{11pt plus 3pt minus 3pt}%
		\setlength{\abovedisplayshortskip}{8pt plus 2pt minus 2pt}%
		\setlength{\belowdisplayshortskip}{8pt plus 2pt minus 2pt}%
	}%
	\normalsize
}

% Paged output places the cover credit on the edition-notice verso; flowing
% output expands the same source in its own front matter.
\NewDocumentCommand{\wavecovercredit}{}{%
	\par\vfill
	{\footnotesize\input{cover-credit}\par}%
}

\NewDocumentCommand{\sourcepagebreak}{}{\par}
