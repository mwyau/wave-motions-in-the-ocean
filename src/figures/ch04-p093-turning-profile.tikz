% wave-source: pdf=ChapmanRizzoli4.pdf; page=30; trim=170bp 430bp 180bp 220bp
% Source: Wave Motions in the Ocean, printed p.93 (physical p.30).
% The asymmetric curve and its two source turning levels are retained as a
% schematic profile; no numerical R^2(z) law is implied.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \draw[->] (2.85,.42)--(2.85,4.82) node[above] {$z$};
  \draw[->] (.48,4.10)--(6.30,4.10) node[right] {$R^2(z)$};
  \draw[line width=.85pt]
    (1.68,4.10)
      .. controls (1.78,3.84) and (2.28,3.64) .. (2.85,3.45)
      .. controls (3.42,3.24) and (4.13,2.94) .. (4.25,2.54)
      .. controls (4.36,2.14) and (3.52,1.54) .. (2.85,1.04)
      .. controls (2.33,.84) and (1.82,.68) .. (1.68,.43);
  \draw[densely dashed] (.55,3.45)--(6.02,3.45);
  \draw[densely dashed] (.55,1.04)--(6.02,1.04);
  \node[anchor=west] at (4.55,3.76) {$R^2<0$};
  \node[anchor=west] at (4.65,2.48) {$R^2>0$};
  \node[anchor=west] at (4.55,.76) {$R^2<0$};
  \node[anchor=east] at (2.38,3.77) {\textit{exponential}};
  \node[anchor=east] at (2.38,2.46) {\textit{Oscillating}};
  \node[anchor=east] at (2.38,.70) {\textit{exponential}};
\end{tikzpicture}
