% wave-source: pdf=ChapmanRizzoli4.pdf; page=30; trim=170bp 430bp 180bp 220bp
% Source: Wave Motions in the Ocean, printed p.93 (physical p.30).
% Deliberately schematic analytic R^2(z) profile with one turning level R^2=0 (N^2=sigma^2); sign controls oscillatory versus evanescent vertical structure.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \draw[->] (3.0,0.45)--(3.0,5.05) node[above] {$z$};
  \draw[->] (0.55,2.70)--(6.55,2.70) node[right] {$R^2$};
  \draw[line width=.85pt,domain=.55:4.75,samples=100,smooth,variable=\z]
    plot ({3.0+1.55*(0.55*(\z-2.62)+0.10*(\z-2.62)^3)},{\z});
  \draw[densely dashed] (0.75,2.62)--(6.15,2.62);
  \fill (3.0,2.62) circle(1.6pt);
  \node[anchor=west] at (3.15,2.42) {turning level: $R^2=0$};
  \node[anchor=west] at (4.15,4.15) {$R^2>0$: oscillatory};
  \node[anchor=east] at (2.45,1.20) {$R^2<0$: evanescent};
  \node[left] at (2.85,0.72) {$-D$}; \node[left] at (2.85,4.72) {$0$};
\end{tikzpicture}
