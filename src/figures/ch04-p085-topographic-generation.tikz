% wave-source: pdf=ChapmanRizzoli4.pdf; page=22; trim=70bp 500bp 55bp 80bp
% Source: Wave Motions in the Ocean, printed p.85 (physical p.22).
% Equation-generated display: h=h0 sin(kx), w=U h_x, sigma=-Uk, and
% m^2=(N/U)^2-k^2. The plotted carrier uses k=100 deg per display-x unit
% (k=1.745329 rad/unit) and the illustrative radiating case N/U=2, giving
% m=0.976640 and characteristic/group-ray slope magnitude k/m=1.787075.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \def\kdeg{100}
  \def\NUratio{2.0}
  \pgfmathsetmacro{\krad}{\kdeg*pi/180}
  \pgfmathsetmacro{\mvert}{sqrt(\NUratio*\NUratio-\krad*\krad)}
  \pgfmathsetmacro{\charslope}{\krad/\mvert}

  \draw[->,line width=.8pt] (0.65,3.65)--(2.30,3.65) node[midway,above] {$U$};
  \draw[line width=.9pt,domain=.5:9.0,samples=160,smooth,variable=\x]
    plot ({\x},{1.30+0.24*sin(\kdeg*\x)});
  \node[anchor=west] at (8.75,0.92) {$h=h_0\sin kx$};
  \draw[->] (0.55,1.05)--(9.25,1.05) node[right] {$x$};
  \draw[->] (0.70,0.70)--(0.70,4.65) node[above] {$z$};

  % At these equally spaced samples cos(kx) has the common magnitude
  % |cos 115 deg| and alternating sign, so the arrows follow w=U h_x exactly.
  \foreach \x/\sgn in {1.15/-1,2.95/1,4.75/-1,6.55/1,8.35/-1}{
    \draw[->,line width=.55pt] (\x,1.55)--(\x,{1.55+0.65*\sgn});
  }
  \node[anchor=west] at (7.15,2.55) {$w=U h_x$};

  % Constant-phase lines obey k x + m z = const, hence dz/dx=-k/m.
  \foreach \x in {1.8,3.0,4.2,5.4,6.6,7.8}{
    \draw[line width=.45pt] (\x,1.9)--++(-1.15,{1.15*\charslope});
  }
  % For sigma=-N k/sqrt(k^2+m^2) and m>0, c_g points left/up with
  % c_gz/c_gx=-k/m, exactly tangent to the phase characteristics above.
  \draw[->,line width=.75pt] (4.65,2.25)--++(-0.80,{0.80*\charslope})
    node[midway,right] {$\vec c_g$};
  \node[anchor=west] at (6.15,4.15) {$k<N/U$: upward radiation};
\end{tikzpicture}
