% wave-source: pdf=ChapmanRizzoli3.pdf; page=17; trim=125bp 380bp 100bp 315bp
% Source: Wave Motions in the Ocean, printed p.52 (physical p.17), upper figure.
% Generated from eta proportional to t*x^(-3/2) cos(g t^2/(4x)+pi/4) at fixed t.
% The dimensionless choice g t^2/4=12 and vertical scale only set display spacing.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.62pt] (0.65,2.15) -- (8.05,2.15) node[right] {$x$};
  \draw[->,line width=0.62pt] (0.75,0.35) -- (0.75,3.95) node[above] {$\eta$};
  \draw[line width=0.82pt,samples=360,smooth,domain=0.7:2.8,variable=\q]
    plot ({0.75+6.9*(\q-0.7)/2.1},
          {2.15+0.95*pow(\q,-1.5)*cos(deg(12/\q+pi/4))});
  \draw[line width=0.46pt,domain=0.7:2.8,samples=100,variable=\q]
    plot ({0.75+6.9*(\q-0.7)/2.1},{2.15+0.95*pow(\q,-1.5)});
  \draw[line width=0.46pt,domain=0.7:2.8,samples=100,variable=\q]
    plot ({0.75+6.9*(\q-0.7)/2.1},{2.15-0.95*pow(\q,-1.5)});
  \draw[->,line width=0.45pt] (5.05,3.55) -- (4.45,3.02);
  \node[anchor=west] at (5.08,3.55) {$x^{-3/2}$};
\end{tikzpicture}
