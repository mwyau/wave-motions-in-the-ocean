% wave-source: pdf=ChapmanRizzoli4.pdf; page=26; trim=120bp 225bp 45bp 395bp
% Source: Wave Motions in the Ocean, printed p.89 (physical p.26), lower panel.
% Source-traced projection construction. The shallow wall, characteristic
% directions, energy arrows, and incident/reflected wavenumbers are retained;
% the pending source convention is not replaced by a modernized derivation.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \coordinate (O) at (4.10,2.10);
  \draw[->,line width=.80pt] (0.55,2.10)--(8.35,2.10) node[right] {$x$};
  \draw[->,line width=.80pt] (4.10,0.35)--(4.10,4.75) node[above] {$z$};

  % The reflecting wall is shallow, as in the source lower construction.
  \path[fill=black!10] (0.78,1.46)--(7.65,2.30)--(7.65,2.43)--(0.78,1.59)--cycle;
  \draw[line width=1.0pt] (0.78,1.52)--(7.65,2.36) node[right] {$z=ax$};

  % Characteristic lines and the two energy directions.
  \draw[line width=.62pt] (1.35,4.12)--(O);
  \node[anchor=west] at (1.04,4.20) {$x+Rz=0$};
  \draw[line width=.62pt] (O)--(7.18,3.36);
  \node[anchor=west] at (6.40,3.46) {$x-Rz=0$};
  \draw[->,line width=.85pt] (2.00,4.02)--(O) node[midway,left] {energy$_i$};
  \draw[->,line width=.85pt] (O)--(5.45,4.12) node[midway,right] {energy$_r$};

  % Incident and reflected wavenumbers.
  \draw[->,line width=.88pt] (O)--(5.38,2.92) node[above right] {$\vec k_i$};
  \draw[->,line width=.88pt] (O)--(5.38,1.25) node[below right] {$\vec k_r$};

  \draw[line width=.42pt] (O) ++(0:0.76) arc[start angle=0,end angle=21,radius=.76];
  \node[anchor=east] at (4.75,2.62) {$\tan^{-1}R$};
  \draw[line width=.42pt] (O) ++(0:0.76) arc[start angle=0,end angle=-31,radius=.76];
  \node[anchor=north] at (4.73,1.72) {$\tan^{-1}R$};
  \draw[line width=.42pt] (O) ++(0:1.05) arc[start angle=0,end angle=7,radius=1.05];
  \node[anchor=west] at (5.70,2.60) {$\tan^{-1}a$};
  \node[anchor=west,align=left] at (6.58,2.78)
    {$(\tan^{-1}R-\tan^{-1}a)$\\$(\tan^{-1}R+\tan^{-1}a)$};
\end{tikzpicture}
