% wave-source: pdf=ChapmanRizzoli4.pdf; page=2; trim=185bp 545bp 155bp 75bp
% Source: Wave Motions in the Ocean, printed p.65 (physical p.2).
% Source-traced density profile with the displaced parcel and its vertical
% displacement bracket. The irregular parcel outline is part of the source
% sketch and is retained instead of replacing it with a geometric marker.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[line width=0.75pt] (0,-0.15) -- (0,3.65);
  \draw[line width=0.75pt] (-0.38,3.20) -- (3.42,3.20);
  \node[anchor=east] at (-0.12,1.55) {$z$};
  \node[anchor=south] at (2.32,3.27) {$\rho$};
  \draw[line width=0.85pt] (0.48,2.92)
    .. controls (1.08,2.58) and (1.86,1.91) .. (2.82,0.55);

  % The parcel sits above the profile, with the dashed vertical displacement
  % line ending on the profile rather than on an added equilibrium dot.
  \draw[line width=0.75pt]
    (2.27,2.35) .. controls (2.20,2.47) and (2.28,2.62) .. (2.43,2.66)
    .. controls (2.56,2.70) and (2.72,2.64) .. (2.77,2.52)
    .. controls (2.85,2.38) and (2.70,2.28) .. (2.56,2.25)
    .. controls (2.43,2.20) and (2.31,2.23) .. cycle;
  \draw[dashed,line width=0.55pt] (2.55,2.25) -- (2.55,1.96);
  \draw[decorate,decoration={brace,amplitude=3pt},line width=0.60pt]
    (2.88,1.96) -- (2.88,2.45);
  \node[anchor=west] at (2.98,2.20) {$\xi$};
\end{tikzpicture}
\end{center}
\smallskip
