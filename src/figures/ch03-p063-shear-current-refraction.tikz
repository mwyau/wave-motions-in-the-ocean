% wave-source: pdf=ChapmanRizzoli3.pdf; page=28; trim=145bp 520bp 150bp 75bp
% Source: Wave Motions in the Ocean, printed p.63 (physical p.28).
% Display redraw of the source ray and current-profile sketches. The local
% wavenumber triangle begins at the end of the ray and does not cross it.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.62pt] (0.70,3.70) -- (7.65,3.70) node[right] {$x$};
  \draw[->,line width=0.62pt] (0.85,3.55) -- (0.85,7.20) node[above] {$y$};
  \draw[line width=0.88pt]
    (0.85,3.85) .. controls (2.25,3.88) and (3.20,4.14) .. (4.25,4.65)
    .. controls (4.70,4.98) and (5.02,5.18) .. (5.30,5.28);
  \node[anchor=south] at (1.95,3.95) {$\theta_0$};

  \coordinate (P) at (5.30,5.28);
  \coordinate (Q) at (6.20,5.28);
  \coordinate (R) at (6.20,6.22);
  \draw[->,line width=0.78pt] (P) -- (R) node[above right] {$\vec k$};
  \draw[line width=0.48pt] (P) -- (Q) node[midway,below] {$k$};
  \draw[line width=0.48pt] (Q) -- (R) node[midway,right] {$\ell$};
  \draw[line width=0.40pt] (P) ++(0:0.58) arc[start angle=0,end angle=46.2,radius=0.58];
  \node at ($(P)+(23.1:0.86)$) {$\theta$};

  \draw[->,line width=0.62pt] (0.70,0.55) -- (7.65,0.55) node[right] {$x$};
  \draw[->,line width=0.62pt] (0.85,0.42) -- (0.85,3.15) node[above] {$V(x)$};
  \pgfmathdeclarefunction{Vdisplay}{1}{%
    \pgfmathparse{0.72+2.10*(3*((#1-0.85)/6.40)^2-2*((#1-0.85)/6.40)^3)}%
  }
  \draw[line width=0.82pt,domain=0.85:7.25,samples=100,variable=\x]
    plot ({\x},{Vdisplay(\x)});
  \foreach \xx in {3.0,3.8,4.6,5.4,6.2}
    \draw[->,line width=0.45pt] (\xx,0.55) -- (\xx,{Vdisplay(\xx)});
\end{tikzpicture}
