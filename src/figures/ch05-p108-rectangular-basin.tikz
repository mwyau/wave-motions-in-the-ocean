% Source: Wave Motions in the Ocean, printed p.108 (physical p.13).
% Vector redraw of the rectangular basin bounded by four solid walls.
\begin{center}
\begin{tikzpicture}[x=0.85cm,y=0.85cm,>=stealth,line cap=round,line join=round,font=\small]
  \filldraw[fill=black!10,draw=black,line width=0.75pt]
    (0,0) rectangle (5.0,1.65);
  \fill[white] (0.14,0.14) rectangle (4.86,1.51);
  \foreach \x/\y in {0.05/0.10,0.05/0.42,0.05/0.74,0.05/1.06,0.05/1.38,
    0.38/0.05,0.82/0.05,1.26/0.05,1.70/0.05,2.14/0.05,2.58/0.05,3.02/0.05,3.46/0.05,3.90/0.05,4.34/0.05,4.78/0.05,
    0.38/1.60,0.82/1.60,1.26/1.60,1.70/1.60,2.14/1.60,2.58/1.60,3.02/1.60,3.46/1.60,3.90/1.60,4.34/1.60,4.78/1.60,
    4.95/0.42,4.95/0.74,4.95/1.06,4.95/1.38}{\fill (\x,\y) circle (0.38pt);}
  \draw[->] (0,0)--(5.65,0) node[right] {$x$};
  \draw[->] (0,0)--(0,2.25) node[above] {$y$};
  \node[below left] at (0,0) {$0$};
  \node[below] at (5,0) {$x=a$};
  \node[left] at (0,1.65) {$y=b$};
\end{tikzpicture}
