% wave-source: pdf=ChapmanRizzoli6.pdf; page=12; trim=75bp 485bp 65bp 160bp
% Source: Wave Motions in the Ocean, printed p.159 (physical p.12), upper figure.
% The source figure uses ell for the positive offshore decay magnitude q=-ell_chapter.
% Thus tan(kL)=k/(ell_chapter-b) becomes tan(kL)=-k/(q+b); rendered labels retain
% the source's ell notation, including ell=infinity for q->infinity.
\begin{tikzpicture}[x=.78cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \def\xaxis{0.85}
  \def\yaxis{3.25}
  \draw[->] (\xaxis,\yaxis)--(10.45,\yaxis) node[right] {$k$};
  \draw[->] (\xaxis,0.45)--(\xaxis,6.55)
    node[above] {$\dfrac{\tan kL\;\mathrm{or}\;-k}{\ell+b}$};
  \begin{scope}
    \clip (\xaxis,0.50) rectangle (10.20,6.25);
    \foreach \a/\b in {0.02/1.54,1.60/3.11,3.18/4.68,4.75/6.25,6.32/7.82,7.89/9.35}{
      \draw[line width=.70pt,domain=\a:\b,samples=100,smooth,variable=\x]
        plot ({\xaxis+\x},{\yaxis+0.68*tan(\x r)});
    }
    \draw[line width=.70pt] (\xaxis,\yaxis)--(10.10,\yaxis);
    \draw[line width=.70pt,domain=0:9.20,samples=2]
      plot ({\xaxis+\x},{\yaxis-0.68*0.15*\x});
    \draw[line width=.70pt,domain=0:8.70,samples=2]
      plot ({\xaxis+\x},{\yaxis-0.68*0.35*\x});
  \end{scope}
  \draw (\xaxis+pi/2,\yaxis-0.13)--(\xaxis+pi/2,\yaxis+0.13)
    node[above=5pt] {$\dfrac{\pi}{2L}$};
  \draw (\xaxis+3*pi/2,\yaxis-0.13)--(\xaxis+3*pi/2,\yaxis+0.13)
    node[above=5pt] {$\dfrac{3\pi}{2L}$};

  % Intersections, independently evaluated from tan(t)+m t=0.
  \foreach \t in {3.14159,6.28318}{
    \draw (\xaxis+\t,\yaxis) ++(-0.11,-0.11)--++(0.22,0.22);
    \draw (\xaxis+\t,\yaxis) ++(-0.11,0.11)--++(0.22,-0.22);
  }
  \foreach \t in {2.75032,5.58578}{
    \pgfmathsetmacro{\yy}{\yaxis-0.68*0.15*\t}
    \draw (\xaxis+\t,\yy) ++(-0.11,-0.11)--++(0.22,0.22);
    \draw (\xaxis+\t,\yy) ++(-0.11,0.11)--++(0.22,-0.22);
  }
  \foreach \t in {2.43566,5.21370}{
    \pgfmathsetmacro{\yy}{\yaxis-0.68*0.35*\t}
    \draw (\xaxis+\t,\yy) ++(-0.11,-0.11)--++(0.22,0.22);
    \draw (\xaxis+\t,\yy) ++(-0.11,0.11)--++(0.22,-0.22);
  }
  \node[anchor=west] at (8.50,3.55) {$\ell=\infty$};
  \draw[->] (8.30,3.58) .. controls (8.05,3.62) and (7.95,3.48) .. (7.80,3.25);
  \node[anchor=west] at (8.20,1.10) {$\ell=0$};
\end{tikzpicture}
