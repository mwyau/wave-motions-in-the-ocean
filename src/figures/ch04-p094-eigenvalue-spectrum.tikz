% wave-source: pdf=ChapmanRizzoli4.pdf; page=31; trim=90bp 225bp 90bp 390bp
% Source: Wave Motions in the Ocean, printed p.94 (physical p.31).
% Generalized spectrum: a sign-changing R^2 profile with representative
% evanescent and travelling eigenfunctions in the same vertical interval.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  % R^2 profile panel
  \draw[->] (0.55,0.60)--(0.55,3.65) node[above] {$z$};
  \draw[->] (0.55,3.20)--(2.55,3.20) node[right] {$R^2(z)$};
  \draw[line width=.75pt]
    (0.80,3.20)
      .. controls (0.62,2.92) and (0.55,2.62) .. (0.55,2.35)
      .. controls (0.82,2.08) and (1.72,2.00) .. (1.72,1.70)
      .. controls (1.72,1.42) and (0.82,1.25) .. (0.55,1.15)
      .. controls (0.48,0.95) and (0.40,0.76) .. (0.32,0.60);
  \draw[densely dashed] (0.75,2.35)--(2.35,2.35);
  \draw[densely dashed] (0.75,1.15)--(2.35,1.15);
  \node at (1.95,2.75) {$<0$};\node at (1.95,1.75) {$>0$};\node at (1.95,0.90) {$<0$};

  % Evanescent eigenfunctions: oscillatory in the outer regions and
  % exponentially shaped through the sign-changing interior.
  \draw[->] (3.15,0.60)--(3.15,3.65) node[above] {$z$};
  \draw[->] (3.15,3.20)--(5.25,3.20) node[right] {$w(z)$};
  \draw[densely dashed] (3.25,2.35)--(5.05,2.35);
  \draw[densely dashed] (3.25,1.15)--(5.05,1.15);
  \draw[line width=.75pt]
    (3.15,3.20)
      .. controls (3.42,3.10) and (2.88,3.04) .. (3.15,2.94)
      .. controls (3.40,2.84) and (2.90,2.75) .. (3.15,2.62)
      .. controls (3.28,2.52) and (3.46,2.42) .. (3.68,2.34)
      .. controls (4.15,2.16) and (4.25,1.50) .. (3.67,1.16)
      .. controls (3.40,1.08) and (2.88,1.02) .. (3.15,0.91)
      .. controls (3.42,0.82) and (2.90,0.76) .. (3.15,0.65);
  \node[draw,inner sep=1pt] at (3.75,3.55) {$k^2<0$};
  \node[align=center] at (4.15,0.75) {evanescent\\modes};

  % Travelling eigenfunctions oscillate across the full interval.
  \draw[->] (5.85,0.60)--(5.85,3.65) node[above] {$z$};
  \draw[->] (5.85,3.20)--(7.95,3.20) node[right] {$w(z)$};
  \draw[densely dashed] (5.95,2.35)--(7.75,2.35);
  \draw[densely dashed] (5.95,1.15)--(7.75,1.15);
  \draw[line width=.75pt,domain=0.65:3.20,samples=150,smooth,variable=\s]
    plot ({5.85+0.60*sin(720*\s)},{\s});
  \node[draw,inner sep=1pt] at (6.50,3.55) {$k^2>0$};
  \node[align=center] at (7.0,0.75) {travelling\\modes};
\end{tikzpicture}
