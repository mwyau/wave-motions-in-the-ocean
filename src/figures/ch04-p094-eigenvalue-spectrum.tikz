% wave-source: pdf=ChapmanRizzoli4.pdf; page=31; trim=90bp 225bp 90bp 390bp
% Source: Wave Motions in the Ocean, printed p.94 (physical p.31).
% Generalized Sturm-Liouville eigenvalue ordering: negative k^2 evanescent sequence and positive k^2 travelling-wave sequence, both unbounded in their stated directions.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \draw[<->] (0.55,2.05)--(9.0,2.05) node[right] {$k^2$};
  \fill (4.75,2.05) circle(1.5pt); \node[below] at (4.75,1.95) {$0$};
  \foreach \x/\lab in {3.72/{$(k_1^e)^2$},2.75/{$(k_2^e)^2$},1.82/{$(k_3^e)^2$}}{\fill (\x,2.05) circle(1.5pt);\node[above] at (\x,2.15){\lab};}
  \foreach \x/\lab in {5.78/{$(k_1^w)^2$},6.75/{$(k_2^w)^2$},7.68/{$(k_3^w)^2$}}{\fill (\x,2.05) circle(1.5pt);\node[above] at (\x,2.15){\lab};}
  \node at (1.05,1.45) {$-\infty\leftarrow\cdots$};
  \node at (8.45,1.45) {$\cdots\rightarrow+\infty$};
  \node at (2.75,3.35) {evanescent modes};
  \node at (6.78,3.35) {travelling modes};
\end{tikzpicture}
