% wave-source: pdf=ChapmanRizzoli4.pdf; page=27; trim=130bp 580bp 110bp 70bp
% Source: Wave Motions in the Ocean, printed p.90 (physical p.27).
% Vector redraw of the three geometry triangles used to obtain the
% wavenumber-ratio relation. The displayed side labels and braces are the
% source construction; the reflection vectors are shown in the following
% figure.
\begin{tikzpicture}[x=1cm,y=1cm,font=\small,line cap=round,line join=round]
  % General cosine-law triangle.
  \coordinate (A) at (0.35,1.55);
  \coordinate (B) at (2.25,0.55);
  \coordinate (C) at (2.25,2.70);
  \draw[line width=0.82pt] (A)--(C)--(B)--cycle;
  \node[anchor=south west] at (1.12,2.07) {$a$};
  \node[anchor=north west] at (1.05,0.93) {$b$};
  \node[anchor=west] at (2.34,1.54) {$c$};
  \node at (0.83,1.55) {$\theta$};

  % First decomposition: unit base, a lower component, and R-a above it.
  \coordinate (D) at (3.55,0.55);
  \coordinate (E) at (6.72,0.55);
  \coordinate (F) at (6.72,1.55);
  \coordinate (G) at (6.72,2.95);
  \draw[line width=0.82pt] (D)--(G)--cycle;
  \draw[line width=0.82pt] (D)--(F);
  \draw[line width=0.82pt] (D)--(E);
  \node[anchor=south] at (5.07,2.00) {$\sqrt{1+R^2}$};
  \node[anchor=south] at (5.15,1.12) {$\sqrt{1+a^2}$};
  \node[anchor=north] at (5.12,0.52) {$1$};
  \draw[decorate,decoration={brace,amplitude=4pt}] (7.02,0.55) -- (7.02,1.55)
    node[midway,right=5pt] {$a$};
  \draw[decorate,decoration={brace,amplitude=4pt}] (7.02,1.55) -- (7.02,2.95)
    node[midway,right=5pt] {$R-a$};
  \draw[decorate,decoration={brace,amplitude=4pt}] (7.38,0.55) -- (7.38,2.95)
    node[midway,right=5pt] {$R$};

  % Second decomposition with the unit middle segment.
  \coordinate (H) at (8.35,1.55);
  \coordinate (I) at (11.52,0.55);
  \coordinate (J) at (11.52,1.55);
  \coordinate (K) at (11.52,2.55);
  \draw[line width=0.82pt] (H)--(K)--(I)--cycle;
  \draw[line width=0.82pt] (H)--(J);
  \node[anchor=south] at (9.88,2.05) {$\sqrt{1+R^2}$};
  \node[anchor=north] at (9.90,1.50) {$1$};
  \node[anchor=north] at (9.88,0.98) {$\sqrt{1+a^2}$};
  \draw[decorate,decoration={brace,amplitude=4pt}] (11.82,0.55) -- (11.82,1.55)
    node[midway,right=5pt] {$a$};
  \node[anchor=west] at (11.85,2.05) {$R$};
\end{tikzpicture}
