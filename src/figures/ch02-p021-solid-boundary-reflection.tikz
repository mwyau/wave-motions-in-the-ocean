% wave-source: pdf=ChapmanRizzoli0_2.pdf; page=31; trim=105bp 444bp 100bp 180bp
% Source: Wave Motions in the Ocean, printed p.21 (physical p.31).
% Vector redraw of incident and reflected plane waves at the solid boundary z=0.
\begin{tikzpicture}[x=0.92cm,y=0.92cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[line width=1.20pt] (0.25,0.35) -- (9.20,0.35);
  \draw[line width=0.42pt] (0.25,0.24) -- (9.20,0.24);
  \foreach \x in {0.35,0.55,...,9.05} {
    \draw[line width=0.32pt] (\x,0.24) -- +(0.10,0.11);
  }
  \draw[->,line width=0.65pt] (5.15,0.35) -- (5.15,4.25) node[above] {$z$};
  \draw[->,line width=0.65pt] (9.20,0.35) -- (9.92,0.35) node[right] {$x$};
  \node at (5.15,4.72) {$p_z=0\ \text{at}\ z=0$};

  % Incident wave crests are normal to the incoming arrow and centered on it.
  \foreach \s in {-0.92,0,0.92} {
    \draw[line width=0.75pt]
      ({2.50+\s},{2.60-\s}) -- ({3.70+\s},{3.80-\s});
  }
  \draw[->,line width=0.82pt] (2.00,4.30) -- (4.20,2.10);
  \node[align=center,font=\bfseries\itshape] at (0.72,3.76) {incident\\wave};

  \draw[->,line width=0.82pt] (5.85,1.10) -- (8.10,3.35);
  \node[align=center,font=\bfseries\itshape] at (8.10,1.93) {reflected\\wave};
\end{tikzpicture}
