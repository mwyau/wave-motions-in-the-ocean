% wave-source: pdf=ChapmanRizzoli3.pdf; page=7; trim=195bp 225bp 180bp 460bp
% Source: Wave Motions in the Ocean, printed p.42 (physical p.7).
% Exact normalized plot of S=sigma*sqrt(D/g)=sqrt(K tanh K), K=kD.
% Its K->0 tangent is S=K and its K->infinity asymptote is S=sqrt(K).
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.65pt] (0.65,0.55) -- (7.30,0.55) node[right] {$k$};
  \draw[->,line width=0.65pt] (0.65,0.55) -- (0.65,4.65) node[above] {$\sigma$};
  \draw[line width=0.90pt,domain=0.001:5.2,samples=120,smooth,variable=\x]
    plot ({0.65+1.20*\x},{0.55+1.45*sqrt(\x*tanh(\x))});
  \draw[->,line width=0.55pt] (1.90,1.18) -- (0.92,0.72);
  \node[anchor=west] at (1.95,1.15) {$\sigma=\sqrt{gD}\,k$};
  \draw[->,line width=0.55pt] (6.70,4.22) -- (6.05,3.78);
  \node[anchor=west] at (6.72,4.20) {$\sigma=\sqrt{gk}$};
\end{tikzpicture}
