% wave-source: pdf=ChapmanRizzoli5.pdf; page=43; trim=105bp 475bp 95bp 35bp
% Source: Wave Motions in the Ocean, printed p.138 (physical p.43).
% Constant-frequency Rossby circle. Equal projection of k_i and k_r along the
% wall means chord IR is exactly normal to the wall. I and R are constructed as
% exact circle/chord intersections; group velocities point radially toward C'.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=0.95cm,y=0.95cm,>=stealth,line cap=round,line join=round,font=\small]
  \coordinate (O) at (0,0);
  \def\centerx{-3.30}
  \def\rad{1.82}
  \def\wallang{102}
  \def\offset{1.15}
  \pgfmathsetmacro{\chordang}{\wallang-90}
  \pgfmathsetmacro{\halfchord}{sqrt(\rad*\rad-\offset*\offset)}
  \pgfmathsetmacro{\mx}{\centerx+\offset*cos(\wallang)}
  \pgfmathsetmacro{\my}{\offset*sin(\wallang)}
  \pgfmathsetmacro{\ix}{\mx+\halfchord*cos(\chordang)}
  \pgfmathsetmacro{\iy}{\my+\halfchord*sin(\chordang)}
  \pgfmathsetmacro{\rx}{\mx-\halfchord*cos(\chordang)}
  \pgfmathsetmacro{\ry}{\my-\halfchord*sin(\chordang)}
  \pgfmathsetmacro{\wallcoord}{\centerx*cos(\wallang)+\offset}
  \coordinate (C) at (\centerx,0);
  \coordinate (M) at (\mx,\my);
  \coordinate (I) at (\ix,\iy);
  \coordinate (R) at (\rx,\ry);
  % W is the exact intersection of chord IR and the wall through O.
  \coordinate (W) at ({\wallcoord*cos(\wallang)},{\wallcoord*sin(\wallang)});
  % W' lies on the circle with C'W' parallel to the wall.
  \coordinate (Wp) at ({\centerx+\rad*cos(\wallang)},{\rad*sin(\wallang)});

  \draw[->,line width=0.8pt] (-5.45,0) -- (1.45,0) node[right] {$k$};
  \draw[->,line width=0.8pt] (0,-1.95) -- (0,2.65) node[above] {$\ell$};
  \draw[line width=5pt,black!18] ({2.00*cos(\wallang)},{2.00*sin(\wallang)}) -- ({-2.00*cos(\wallang)},{-2.00*sin(\wallang)});
  \draw[line width=0.75pt] ({2.00*cos(\wallang)},{2.00*sin(\wallang)}) -- ({-2.00*cos(\wallang)},{-2.00*sin(\wallang)});

  \draw[line width=0.75pt] (C) circle[radius=\rad];
  \fill (C) circle (1.3pt) node[below=2pt] {$C'$};
  \node[below right=1pt] at (O) {$O$};

  \draw[dashed,line width=0.65pt] (R) -- (W);
  \node[above=2pt] at (I) {$I$};
  \node[above left=1pt] at (R) {$R$};
  \node[above=2pt] at (W) {$W$};
  \begin{scope}[shift={(W)},rotate=\wallang]
    \draw[line width=0.55pt] (0.18,0) -- (0.18,0.18) -- (0,0.18);
  \end{scope}

  \draw[->,line width=0.80pt] (O) -- (I);
  \draw[->,line width=0.80pt] (O) -- (R);
  \node[anchor=north west] at (-1.32,0.43) {$\vec k_i$};
  \node[anchor=north] at (-2.92,-0.16) {$\vec k_r$};

  \draw[->,line width=0.80pt] (I) -- (C);
  \draw[->,line width=0.80pt] (R) -- (C);
  \node[anchor=south] at (-2.55,1.36) {$\vec c_{g i}$};
  \node[anchor=north] at (-4.62,0.22) {$\vec c_{g r}$};

  \draw[dashed,line width=0.65pt] (C) -- (Wp);
  \node[above left=1pt] at (Wp) {$W'$};
  \begin{scope}[shift={(M)},rotate=\wallang]
    \draw[line width=0.55pt] (0.16,0) -- (0.16,0.16) -- (0,0.16);
  \end{scope}

  \draw[line width=0.55pt] (0.62,0) arc[start angle=0,end angle=\wallang-90,radius=0.62];
  \node at (0.80,0.23) {$\mu$};
\end{tikzpicture}
\end{center}
\smallskip
