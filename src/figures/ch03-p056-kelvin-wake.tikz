% wave-source: pdf=ChapmanRizzoli3.pdf; page=21; trim=145bp 500bp 125bp 145bp
% Source: Wave Motions in the Ocean, printed p.56 (physical p.21), upper figure.
% The outer cusp and the two straight phase-line families are source-traced.
% The phase lines are parallel within each family; only the outer cusp lines
% meet at the ship's wake.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \coordinate (S) at (8.85,2.45);

  % The two outer boundaries converge at V. The interior phase lines do not:
  % they remain parallel and terminate before the vertex, as in the source.
  \draw[line width=0.72pt] (S) -- (1.25,4.82);
  \draw[line width=0.72pt] (S) -- (1.25,0.08);
  \foreach \x/\y in {1.25/4.55,1.25/4.27,1.25/3.99,1.25/3.71}
    \draw[line width=0.52pt] (\x,\y) -- (8.00,{\y-0.18*(8.00-\x)});
  \foreach \x/\y in {1.25/0.35,1.25/0.63,1.25/0.91,1.25/1.19}
    \draw[line width=0.52pt] (\x,\y) -- (8.00,{\y+0.18*(8.00-\x)});

  % Five curved crest traces on each side of the wake.
  \draw[line width=0.52pt] (1.68,0.02) .. controls (2.25,1.25) and (2.25,3.68) .. (1.68,4.88);
  \draw[line width=0.52pt] (2.78,0.34) .. controls (3.25,1.50) and (3.25,3.43) .. (2.78,4.56);
  \draw[line width=0.52pt] (3.82,0.67) .. controls (4.20,1.58) and (4.20,3.28) .. (3.82,4.23);
  \draw[line width=0.52pt] (4.84,1.00) .. controls (5.15,1.65) and (5.15,3.19) .. (4.84,3.90);
  \draw[line width=0.52pt] (5.86,1.42) .. controls (6.10,1.85) and (6.10,3.00) .. (5.86,3.48);

  \draw[->,line width=0.90pt] (S) -- ++(1.05,0) node[right] {$V$};
  \draw[->,line width=0.42pt] ($(S)+(160.529:0.72)$) arc[start angle=160.529,end angle=180,radius=0.72];
  \draw[->,line width=0.42pt] ($(S)+(180:0.72)$) arc[start angle=180,end angle=199.471,radius=0.72];
  \node[anchor=south east] at ($(S)+(166:1.18)$) {$19^\circ28'$};
  \node[anchor=north east] at ($(S)+(194:1.18)$) {$19^\circ28'$};

  \node[anchor=west] at (0.82,3.08) {Large};
  \node[anchor=west] at (0.82,2.62) {Amplitude};
  \node[anchor=south] at (4.25,4.42) {Small Amplitude};
  \node[anchor=north] at (4.25,0.36) {Small Amplitude};
  \node at (3.55,2.98) {Crests};
  \draw[->,line width=0.42pt] (3.36,3.18) .. controls (3.05,3.39) and (2.75,3.39) .. (2.50,3.24);
  \draw[->,line width=0.42pt] (3.74,2.80) .. controls (4.05,2.60) and (4.35,2.60) .. (4.64,2.72);
\end{tikzpicture}
