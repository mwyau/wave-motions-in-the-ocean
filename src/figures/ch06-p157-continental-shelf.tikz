% wave-source: pdf=ChapmanRizzoli6.pdf; page=10; trim=155bp 560bp 140bp 80bp
% Source: Wave Motions in the Ocean, printed p.157 (physical p.10).
% Schematic stippled cross-section: coast x=0, shelf edge x=L, offshore x,
% alongshore y, and flat deep-ocean depth H.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \coordinate (O) at (1.05,4.30);
  \draw[->] (O)--(8.85,4.30) node[right] {$x$};
  \draw[->] (O)--(1.05,0.55) node[below] {$z$};
  \draw[->] (O)--(3.05,5.20) node[above] {$y$};
  \path[fill=black!12] (1.05,4.30)
    .. controls (2.0,4.28) and (3.0,3.85) .. (4.25,2.80)
    .. controls (4.75,2.25) and (4.95,1.55) .. (5.20,1.10)
    -- (8.75,1.10)--(8.75,0.80)--(1.05,0.80)--cycle;
  \draw[line width=.9pt] (1.05,4.30)
    .. controls (2.0,4.28) and (3.0,3.85) .. (4.25,2.80)
    .. controls (4.75,2.25) and (4.95,1.55) .. (5.20,1.10)
    -- (8.75,1.10);
  \draw[line width=.9pt] (1.05,4.30)--(1.05,0.80)--(8.75,0.80);
  \foreach \x/\y in {1.25/3.8,1.6/3.5,1.95/3.2,2.3/3.1,2.65/2.8,3.0/2.5,3.35/2.25,3.7/2.0,4.05/1.7,4.4/1.35,4.8/1.05,5.6/0.95,6.1/0.95,6.6/0.95,7.1/0.95,7.6/0.95,8.1/0.95}{\fill (\x,\y) circle (0.45pt);}
  \node[anchor=west] at (1.25,3.45) {$x=0$};
  \node[anchor=west] at (4.85,1.55) {$z=-H$};
  \draw[|-,line width=.55pt] (5.20,0.60)--(5.20,1.10);
  \node[below] at (5.20,0.55) {$x=L$};
\end{tikzpicture}
