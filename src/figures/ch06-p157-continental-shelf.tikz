% wave-source: pdf=ChapmanRizzoli6.pdf; page=10; trim=155bp 560bp 140bp 80bp
% Source: Wave Motions in the Ocean, printed p.157 (physical p.10).
% Cross-shelf depth follows the chapter's analytic profile D=D0 exp(2 b x) on
% 0<x<L and is constant offshore. Display values bL=0.45, D0/H=exp(-0.9).
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \def\L{5.2}
  \draw[->] (0.8,4.65)--(8.9,4.65) node[right] {$x$ offshore};
  \draw[->] (0.8,4.65)--(0.8,0.45) node[below] {$z$};
  \draw[line width=1.0pt,domain=0:5.2,samples=120,smooth,variable=\x]
    plot ({0.8+\x},{4.65-0.86*exp(0.1730769*\x)});
  \draw[line width=1.0pt] (6.0,2.53)--(8.55,2.53);
  \draw[line width=1.2pt] (0.8,4.65)--(0.8,3.79);
  \draw[densely dashed] (6.0,4.65)--(6.0,2.53);
  \node[above] at (0.8,4.65) {coast};
  \node[above] at (6.0,4.65) {$x=L$};
  \node[anchor=west] at (8.62,2.53) {$H$};
  \node[anchor=west] at (2.0,3.6) {$D(x)=D_0e^{2bx}$};
  \draw[->,line width=.8pt] (2.0,5.35)--(2.0,6.45) node[above] {$y$ alongshore};
  \node[anchor=west] at (6.45,3.35) {flat deep ocean};
\end{tikzpicture}
