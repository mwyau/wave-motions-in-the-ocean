% wave-source: pdf=ChapmanRizzoli3.pdf; page=27; trim=65bp 415bp 70bp 130bp
% Source: Wave Motions in the Ocean, printed p.62 (physical p.27).
% For normalized g=D=sigma=1, roots satisfy sqrt(k tanh k)=1+|U|k.
% The critical tangency independently solves f(k)-k f'(k)=1: k=4.0426,
% |U|=f'(k)=0.2498. The upper wave uses the small-k root as |U| increases.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.55pt] (5.0,6.05) -- (9.65,6.05) node[right] {$x$};
  \draw[line width=0.72pt,domain=0:8,samples=80,variable=\x]
    plot ({5.10+0.53*\x},{6.00-0.72/(1+exp(-1.5*(\x-4)))});
  \node[left] at (4.95,6.50) {$U$};
  \draw[->,line width=0.55pt] (5.0,4.52) -- (9.65,4.52) node[right] {$x$};
  \draw[line width=0.70pt,domain=0:8,samples=200,variable=\x]
    plot ({5.10+0.53*\x},{4.52+0.18*sin(deg(6.5*\x+0.35*\x*\x))});
  \node[left] at (4.95,4.52) {$\eta$};

  \draw[->,line width=0.60pt] (0.75,0.65) -- (5.25,0.65) node[right] {$k$};
  \draw[->,line width=0.60pt] (1.05,0.40) -- (1.05,4.00) node[above] {$f(k)$};
  \draw[line width=0.82pt,domain=0:4.3,samples=120,smooth,variable=\x]
    plot ({1.05+0.95*\x},{0.65+1.25*sqrt(\x*tanh(\x))});
  \draw[line width=0.48pt,domain=0:4.3,variable=\x]
    plot ({1.05+0.95*\x},{0.65+1.25});
  \draw[line width=0.48pt,domain=0:4.3,variable=\x]
    plot ({1.05+0.95*\x},{0.65+1.25*(1+0.10*\x)});
  \draw[line width=0.48pt,domain=0:4.3,variable=\x]
    plot ({1.05+0.95*\x},{0.65+1.25*(1+0.249840*\x)});
  \node[anchor=west] at (5.05,1.90) {$|U|=0$};
  \node[anchor=west] at (2.18,2.62) {$\sigma+k|U|$};
  \node[anchor=west] at (2.65,3.58) {$(gk\tanh kD)^{1/2}$};
  \node[anchor=east] at (1.00,2.70) {$|U|$ increases};
  \draw[->,line width=0.40pt] (1.42,2.18) .. controls (0.84,2.02) and (0.68,1.58) .. (1.10,1.30);
  \node at (2.1897,1.9000) {$\ast$};
  \node at (2.4397,2.0829) {$\ast$};
  \node at (4.8905,3.1625) {$\ast$};
\end{tikzpicture}
