% wave-source: pdf=ChapmanRizzoli4.pdf; page=18; trim=115bp 410bp 100bp 215bp
% Source: Wave Motions in the Ocean, printed p.81 (physical p.18).
% Exact n=1 vertical factors: w~sin(pi(z+D)/D), u~cos(pi(z+D)/D).
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  % w panel
  \draw[->] (0.90,0.55)--(0.90,4.25) node[above] {$z$};
  \draw[->] (0.90,3.75)--(3.50,3.75) node[right] {$w$};
  \draw (0.78,3.75)--(1.02,3.75) node[left=3pt] {$z=0$};
  \draw (0.78,0.85)--(1.02,0.85) node[left=3pt] {$z=-D$};
  \draw[densely dashed] (0.90,0.85)--(3.35,0.85);
  \draw[line width=.85pt,domain=0:1,samples=100,smooth,variable=\s]
    plot ({0.90+1.95*sin(180*\s)},{0.85+2.90*\s});
  \node[anchor=west] at (2.20,3.98) {$w_0$};
  % u panel
  \draw[->] (5.00,0.55)--(5.00,4.25) node[above] {$z$};
  \draw[->] (3.75,3.75)--(7.45,3.75) node[right] {$u$};
  \draw (3.75,3.75)--(5.12,3.75);
  \node[anchor=east] at (3.75,3.75) {$z=0$};
  \draw (3.75,0.85)--(5.12,0.85);
  \node[anchor=east] at (3.75,0.85) {$z=-D$};
  \draw[densely dashed] (3.75,0.85)--(7.25,0.85);
  \draw[line width=.85pt,domain=0:1,samples=100,smooth,variable=\s]
    plot ({5.00+1.55*cos(180*(1-\s))},{0.85+2.90*\s});
  \node[anchor=east] at (4.55,3.98) {$-Rw_0$};
  \node[anchor=west] at (5.42,3.98) {$Rw_0$};
\end{tikzpicture}
