% wave-source: pdf=ChapmanRizzoli0_2.pdf; page=34; trim=145bp 155bp 190bp 500bp
% Source: Wave Motions in the Ocean, printed p.24 (physical p.34).
% Equation-defined redraw using normalized variables K=(k^2+l^2)^{1/2}D/pi and
% S=sigma D/(pi c_0), for which S_n=sqrt(K^2+n^2).  The n=0 branch is linear;
% n=1,2 have cutoffs at S=1,2 and approach parallel slope asymptotically.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.65pt] (0.7,0.55) -- (7.65,0.55) node[below left=1pt] {$(k^2+\ell^2)^{1/2}$};
  \draw[->,line width=0.65pt] (0.7,0.55) -- (0.7,4.75) node[left=2pt] {$\sigma$};
  \draw[line width=0.80pt,domain=0:5.2,samples=80,smooth,variable=\x]
    plot ({0.7+1.22*\x},{0.55+0.70*sqrt(\x*\x)});
  \draw[line width=0.80pt,domain=0:5.2,samples=80,smooth,variable=\x]
    plot ({0.7+1.22*\x},{0.55+0.70*sqrt(\x*\x+1)});
  \draw[line width=0.80pt,domain=0:5.2,samples=80,smooth,variable=\x]
    plot ({0.7+1.22*\x},{0.55+0.70*sqrt(\x*\x+4)});
  \node[anchor=west] at (2.70,0.95) {$n=0$};
  \node[anchor=west] at (0.90,1.34) {$n=1$};
  \node[anchor=west] at (0.90,2.03) {$n=2$};
\end{tikzpicture}
