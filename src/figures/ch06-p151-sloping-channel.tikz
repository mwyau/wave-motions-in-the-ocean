% wave-source: pdf=ChapmanRizzoli6.pdf; page=4; trim=155bp 515bp 145bp 125bp
% Source: Wave Motions in the Ocean, printed p.151 (physical p.4).
% Perspective redraw of the channel used in the derivation. The receding
% sidewalls, hidden bottom edge, and front cross-section follow the source.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  % The source shows a long channel receding to the left from the x=0
  % cross-section. The two bottom edges encode the gradual rise alpha y.
  \coordinate (A)  at (3.20,3.00);
  \coordinate (B)  at (4.75,3.65);
  \coordinate (C)  at (3.20,1.25);
  \coordinate (D)  at (4.75,2.00);
  \coordinate (A0) at (-1.30,3.55);
  \coordinate (B0) at (0.25,4.20);
  \coordinate (C0) at (-1.30,1.80);
  \coordinate (D0) at (0.25,2.55);

  % Long sidewall and bottom traces.
  \draw[line width=.85pt] (A0)--(A) (B0)--(B);
  \draw[line width=.85pt] (C0)--(C);
  \draw[densely dashed,line width=.65pt] (D0)--(D);
  \draw[densely dashed,line width=.55pt] (C0)--(D0);

  % The visible x=0 cross-section and its sloping bottom.
  \draw[line width=.85pt] (A)--(B)--(D)--(C)--cycle;

  % Coordinate directions at the upper near corner.
  \draw[->,line width=.75pt] (A)--(4.45,3.00) node[above] {$x$};
  \draw[->,line width=.75pt] (A)--(4.12,3.42) node[above right] {$y$};
  \draw[->,line width=.75pt] (A)--(3.20,4.05) node[above] {$z$};

  \node[anchor=west] at (4.86,3.66) {$y=L$};
  \node[anchor=north] at (3.17,1.18) {$z=-H$};
  \node[anchor=west] at (3.76,2.13) {$z=-H+\alpha y$};
\end{tikzpicture}
