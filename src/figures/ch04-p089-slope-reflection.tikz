% wave-source: pdf=ChapmanRizzoli4.pdf; page=26; trim=75bp 540bp 55bp 65bp
% Source: Wave Motions in the Ocean, printed p.89 (physical p.26).
% Internal-wave energy reflects between the two fixed characteristic slopes +-1/R, not specularly about the wall normal.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \def\R{1.35}\def\a{0.30}
  \coordinate (O) at (4.4,1.55);
  \draw[line width=1.0pt] (0.55,0.70)--(8.65,3.13) node[right] {$z=ax$};
  \draw[densely dashed] (O)--++(0.80,2.67) node[above] {normal};
  \draw[->,line width=.85pt] ($(O)+(-2.80,2.074)$)--(O) node[midway,above left] {incident energy};
  \draw[->,line width=.85pt] (O)--++(2.80,2.074) node[midway,above right] {reflected energy};
  \draw[->,line width=.7pt] (O)--++(1.15,1.55) node[right] {$\vec k_i$};
  \draw[->,line width=.7pt] (O)--++(1.65,-2.23) node[right] {$\vec k_r$};
  \node[anchor=west] at (0.70,4.60) {energy slopes $\mp R^{-1}$ are fixed by $\sigma$};
\end{tikzpicture}
