  \filldraw[fill=black!15,draw=black,line width=0.75pt]
    (0,-0.15) -- (0,1.46) -- (3.45,1.46) -- (3.45,0.34) -- (6.55,0.34)
    -- (6.55,-0.15) -- cycle;
  \foreach \x/\y in {0.18/0.10,0.55/0.34,0.92/0.10,1.29/0.34,1.66/0.10,2.03/0.34,2.40/0.10,2.77/0.34,3.14/0.10,
