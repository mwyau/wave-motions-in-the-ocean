% wave-source: pdf=ChapmanRizzoli4.pdf; page=27; trim=95bp 210bp 75bp 425bp
% wave-source-mask: pdf=ChapmanRizzoli4.pdf; page=27; rect=95bp 361bp 205bp 367bp; origin=lower-left; reason=remove the overlapping prose baseline while preserving the complete z label
% Source: Wave Motions in the Ocean, printed p.90 (physical p.27).
% Source-traced velocity-reflection construction. The source's pending signed
% convention is left unchanged; this redraw only restores the vector geometry.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \coordinate (O) at (4.55,0.85);

  % Shallow reflecting wall and coordinate axes.
  \path[fill=black!10] (0.85,0.38)--(8.20,1.18)--(8.20,1.30)--(0.85,0.50)--cycle;
  \draw[line width=1.0pt] (0.85,0.44)--(8.20,1.24) node[right] {$z=ax$};
  \draw[->,line width=.65pt] (O)--(7.90,0.85) node[right] {$x$};
  \draw[->,line width=.72pt] (O)--(4.55,4.45) node[above] {$z$};

  % The two characteristic directions are not specular to the sloping wall.
  \draw[line width=.62pt] (2.15,3.92)--(O);
  \node[anchor=west] at (1.45,4.02) {$x+Rz=0$};
  \draw[line width=.62pt] (O)--(7.55,3.80);
  \node[anchor=west] at (6.35,3.96) {$x-Rz=0$};
  \draw[line width=.42pt] (2.70,3.37)--(7.55,3.80);
  \draw[line width=.42pt] (4.15,4.45)--(O);

  % Incident velocity points into the wall; reflected velocity leaves it.
  \draw[->,line width=.92pt] (2.75,3.35)--(O) node[midway,left] {$v_i$};
  \draw[->,line width=.92pt] (O)--(6.75,3.22) node[midway,below] {$v_r$};

  % Source angle guides at the wall and at the characteristic directions.
  \draw[line width=.42pt] (O) ++(0:0.78) arc[start angle=0,end angle=6.2,radius=.78];
  \node[anchor=south] at (6.15,1.12) {$\tan^{-1}a$};
  \draw[line width=.42pt] (O) ++(0:0.98) arc[start angle=0,end angle=42,radius=.98];
  \node[anchor=west] at (5.25,2.52) {$\tan^{-1}R^{-1}$};
  \draw[line width=.42pt] (O) ++(0:0.98) arc[start angle=0,end angle=137,radius=.98];
  \node[anchor=east] at (3.55,2.62) {$\tan^{-1}R^{-1}$};
  \draw[line width=.42pt] (O) ++(0:1.28) arc[start angle=0,end angle=6.2,radius=1.28];
  \node[anchor=south] at (6.45,4.32) {$\tan^{-1}a$};
\end{tikzpicture}
