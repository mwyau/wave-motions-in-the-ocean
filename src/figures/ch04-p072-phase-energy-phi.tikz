% wave-source: pdf=ChapmanRizzoli4.pdf; page=9; trim=105bp 129bp 95bp 520bp
% Source: Wave Motions in the Ocean, printed p.72 (physical p.9), lower pair.
% c_g is the energy-propagation direction. The phase arrow is perpendicular to
% it, with the source placement and direction retained in both panels.
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \def\cgangle{31.908107}
  \foreach \dx/\title/\pdir in {0/{$f>N$}/-58.091893,5.1/{$f<N$}/121.908107} {
    \begin{scope}[shift={(\dx,0)}]
      \node[draw,inner sep=3pt] at (1.55,2.75) {\title};
      \draw (0,-0.30)--(0,2.35);
      \draw (-0.55,0)--(3.35,0);
      \draw[->,line width=0.8pt] (0,0)--(2.65,1.65) node[right] {$\vec c_g$};
      \node[anchor=west] at (2.12,1.02) {(energy)};
      \draw (0,0.62) arc[start angle=90,end angle=\cgangle,radius=0.62];
      \node at (0.35,0.58) {$\phi$};
      \ifdim\dx pt=0pt
        \draw[->,line width=0.8pt] (1.35,1.22)--(2.00,0.30);
        \node[anchor=west] at (2.05,0.28) {phases};
      \else
        \draw[->,line width=0.8pt] (1.85,0.82)--(1.10,1.70);
        \node[anchor=east] at (1.05,1.73) {phases};
      \fi
    \end{scope}
  }
\end{tikzpicture}
\end{center}
