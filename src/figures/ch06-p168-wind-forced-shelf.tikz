% wave-source: pdf=ChapmanRizzoli6.pdf; page=22; trim=155bp 420bp 135bp 240bp
% Source: Wave Motions in the Ocean, printed p.168 (physical p.22).
% Geometry follows the long-wave setup: x offshore, y alongshore, D=D(x), coast at
% x=0, shelf edge x=L, and alongshelf wind stress tau^y. Bathymetric shape is schematic.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \draw[line width=1.2pt] (1.0,0.65)--(1.0,5.15);
  \node[rotate=90,above] at (0.85,2.9) {coast $x=0$};
  \draw[->] (1.0,4.55)--(8.8,4.55) node[right] {$x$ offshore};
  \draw[->] (2.0,1.05)--(2.0,5.75) node[above] {$y$ alongshore};
  \draw[line width=.95pt] (1.0,3.95) .. controls (3.3,3.8) and (4.3,3.15) .. (5.65,2.10) -- (8.55,2.10);
  \draw[densely dashed] (5.65,4.55)--(5.65,2.10);
  \node[above] at (5.65,4.55) {$x=L$};
  \node[anchor=west] at (6.0,2.35) {deep ocean};
  \node[anchor=west] at (2.55,3.25) {$D(x)$};
  \draw[->,line width=1.0pt] (3.35,4.95)--(3.35,6.15) node[above] {$\tau^y$};
  \draw[->,line width=.7pt] (4.10,4.85)--(4.10,5.65);
  \draw[->,line width=.7pt] (4.80,4.85)--(4.80,5.65);
  \node[anchor=west] at (5.1,5.3) {alongshelf wind};
\end{tikzpicture}
