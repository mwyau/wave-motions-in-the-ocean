% wave-source: pdf=ChapmanRizzoli6.pdf; page=5; trim=175bp 155bp 185bp 490bp
% Source: Wave Motions in the Ocean, printed p.152 (physical p.5).
% The two displayed profiles are schematic limits of the chapter's cosh(mu z)
% solution, both terminating on the sloping bottom z=-H+alpha y.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \draw[->] (1.0,0.65)--(1.0,4.85) node[above] {$z$};
  \draw[->] (1.0,4.35)--(7.45,4.35);
  \draw[line width=.85pt] (0.65,0.95)--(7.10,1.75);
  \node[anchor=west] at (2.10,0.62) {$z=-H+\alpha y$};
  \draw[line width=.90pt,domain=0:1,samples=100,smooth,variable=\s]
    plot ({1.0+2.05*cosh(2.6*(1-\s))/cosh(2.6)},{1.33+3.07*\s});
  \draw[line width=.90pt,domain=0:1,samples=100,smooth,variable=\s]
    plot ({1.0+4.45*cosh(0.65*(1-\s))/cosh(0.65)},{1.63+2.77*\s});
  \node[anchor=east] at (2.05,1.95) {$Sk\ {\rm large}$};
  \node[anchor=west] at (5.25,3.15) {$Sk\ {\rm small}$};
\end{tikzpicture}
