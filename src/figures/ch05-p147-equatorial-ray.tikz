% wave-source: pdf=ChapmanRizzoli5.pdf; page=52; trim=175bp 530bp 150bp 45bp
% Source: Wave Motions in the Ocean, printed p.147 (physical p.52).
% Orthographic vector reconstruction of the source globe sketch. The figure
% retains one refracted ray between the two trapping latitudes and the source
% labels; pending p.146--147 ray-direction errata do not alter this drawing.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,line cap=round,line join=round,font=\small]
  \coordinate (C) at (4.05,2.55);
  \draw[line width=.85pt] (C) circle[radius=2.15];

  % The two trapping latitudes are shallow arcs across the globe.
  \draw[dashed,line width=.60pt]
    (2.02,3.18) .. controls (3.05,2.82) and (5.05,2.82) .. (6.08,3.18);
  \draw[dashed,line width=.60pt]
    (2.02,1.92) .. controls (3.10,1.62) and (5.00,1.62) .. (6.08,1.92);

  % A single source-like sinusoidal ray is continuously refracted between the
  % two trapping latitudes. It is intentionally one trace, not a globe-scale
  % family of separately scaled waves.
  \draw[line width=1.05pt,samples=180,domain=0:1,variable=\t]
    plot ({2.08+3.94*\t},{2.55+0.34*sin(720*\t+40)-0.04*\t});

  \node[anchor=west] at (6.24,3.18) {$+\theta_T$};
  \node[anchor=west] at (6.24,1.92) {$-\theta_T$};
\end{tikzpicture}
\end{center}
\smallskip
