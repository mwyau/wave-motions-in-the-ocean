% wave-source: pdf=ChapmanRizzoli5.pdf; page=37; trim=158.40bp 140bp 160.32bp 537.60bp
% Source: Wave Motions in the Ocean, printed p.132 (physical p.37), lower sketch.
% Geostrophic flow around a Northern Hemisphere pressure high is clockwise.
% Because transport between equal isobars is proportional to 1/f, the southern
% side carries more transport: convergence occurs west (A) and divergence east (B).
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \coordinate (H) at (0,0);
  \foreach \r in {0.40,0.70,1.00,1.30} {
    \draw[line width=0.65pt] (H) circle[radius=\r];
  }
  \draw[->,line width=0.75pt] (112:1.30) arc[start angle=112,end angle=56,radius=1.30];
  \draw[->,line width=0.75pt] (108:1.00) arc[start angle=108,end angle=50,radius=1.00];
  \draw[->,line width=0.75pt] (104:0.70) arc[start angle=104,end angle=44,radius=0.70];
  \draw[->,line width=0.75pt] (100:0.40) arc[start angle=100,end angle=38,radius=0.40];
  \draw[->,line width=0.75pt] (292:1.30) arc[start angle=292,end angle=236,radius=1.30];
  \draw[->,line width=0.75pt] (298:1.00) arc[start angle=298,end angle=242,radius=1.00];
  \draw[->,line width=0.75pt] (304:0.70) arc[start angle=304,end angle=248,radius=0.70];
  \draw[->,line width=0.75pt] (310:0.40) arc[start angle=310,end angle=254,radius=0.40];

  \node at (H) {$H$};
  \node at (-1.30,0) {$A$};
  \node at (1.30,0) {$B$};
  \node[anchor=east,align=right] at (-2.05,0.18)
    {Convergence:\\Pressure rises\\at A};
  \node[anchor=west,align=left] at (2.05,0.18)
    {Divergence:\\Pressure drops\\at B};
\end{tikzpicture}
\end{center}
\smallskip
