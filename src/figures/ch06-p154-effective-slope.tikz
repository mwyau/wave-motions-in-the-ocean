% wave-source: pdf=ChapmanRizzoli6.pdf; page=7; trim=120bp 520bp 85bp 125bp
% Source: Wave Motions in the Ocean, printed p.154 (physical p.7).
% Exact scaled cross-section: z'=Rz makes the bottom z'=R alpha x and
% theta=atan(R alpha). Tangent/normal directions identify along-bottom k and decay m.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \def\ang{28}
  \coordinate (O) at (1.0,1.0);
  \draw[->] (0.65,1.0)--(8.5,1.0) node[right] {$x$};
  \draw[->] (1.0,0.55)--(1.0,5.1) node[above] {$z'$};
  \draw[line width=1.0pt] (O)--++(\ang:7.0);
  \node[above=6pt] at ($(O)+(\ang:5.9)$) {$z'=R\alpha x$};
  \draw[->,line width=.85pt] ($(O)+(\ang:2.0)$)--++(\ang:2.25) node[midway,above] {$k$};
  \draw[->,line width=.85pt] ($(O)+(\ang:4.2)$)--++({\ang+90}:1.8) node[midway,right] {$m$};
  \draw[densely dashed] ($(O)+(\ang:4.2)$)--++({\ang+90}:3.1);
  \draw[->] ($(O)+(0:1.05)$) arc[start angle=0,end angle=\ang,radius=1.05];
  \node at ($(O)+(14:1.4)$) {$\theta$};
  \node[anchor=west] at (5.15,5.05) {$\tan\theta=R\alpha=\dfrac{S}{\sqrt{1-\omega^2}}$};
  \node[anchor=west] at (5.15,4.28) {decay away from bottom};
\end{tikzpicture}
