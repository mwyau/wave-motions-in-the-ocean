% wave-source: pdf=ChapmanRizzoli6.pdf; page=7; trim=120bp 520bp 85bp 125bp
% Source: Wave Motions in the Ocean, printed p.154 (physical p.7).
% Paired original/scaled slopes and their governing field equations.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \path[fill=black!10] (0.55,0.62)--(2.95,3.47)--(2.95,3.63)--(0.55,0.78)--cycle;
  \path[fill=black!10] (5.55,0.62)--(7.95,3.47)--(7.95,3.63)--(5.55,0.78)--cycle;
  \draw[line width=1.0pt] (0.55,0.70)--(2.95,3.55);
  \draw[line width=1.0pt] (5.55,0.70)--(7.95,3.55);
  \node[align=center] at (1.55,2.92) {$p_{xx}+p_{yy}+\left(\dfrac{f^2-\sigma^2}{N^2}\right)p_{zz}=0$};
  \node[align=center] at (1.58,1.65) {$z=\alpha x$\\$w=\alpha u$};
  \node[align=center] at (6.70,2.92) {$p_{xx}-\ell^2p+p_{z'z'}=0$};
  \node[anchor=west] at (6.00,1.60) {$z'=R\alpha x$};
  % The source uses a large outlined transformation arrow between the two
  % slope panels.
  \draw[fill=white,line width=.75pt]
    (3.45,2.22)--(4.35,2.22)--(4.35,2.52)--(5.00,2.05)--
    (4.35,1.58)--(4.35,1.88)--(3.45,1.88)--cycle;
\end{tikzpicture}
