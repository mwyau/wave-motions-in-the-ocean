% wave-source: pdf=ChapmanRizzoli5.pdf; page=22; trim=168.00bp 555.84bp 174.72bp 110.40bp
% Source: Wave Motions in the Ocean, printed p.117 (physical p.22).
% Equation-generated forced shelf/deep-ocean cross-shelf structure.
% Display parameters choose ell=0, D_1/D_2=0.35 and k_1 L=9 pi/2. The
% shelf and deep curves are phase-matched at x=L; the ratio and phase are
% display choices made to retain the several shelf oscillations and the visible
% deep-ocean oscillation in the source sketch.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=0.95cm,y=0.95cm,line cap=round,line join=round,font=\small]
  \def\shelfL{2.95}
  \def\depthratio{0.35}
  \pgfmathsetmacro{\kone}{4.5*pi/\shelfL}
  \pgfmathsetmacro{\ktwo}{\kone*sqrt(\depthratio)}
  \def\amp{0.40}

  \filldraw[fill=black!15,draw=black,line width=0.75pt]
    (0,-0.12) -- (0,0.62) -- (\shelfL,0.62) -- (\shelfL,0.08) -- (6.10,0.08)
    -- (6.10,-0.12) -- cycle;
  \draw[line width=0.75pt] (0,0.62) -- (0,1.48);
  \draw[dashed,line width=0.55pt] (0,1.48) -- (6.12,1.48);
  \node at (1.55,0.84) {$D_1$};
  \node at (4.65,0.68) {$D_2$};

  % The source uses a dense stipple to distinguish the solid bottom. A sparse
  % regular field keeps that visual cue in the vector reconstruction.
  \foreach \x/\y in {0.18/0.30,0.52/0.20,0.88/0.36,1.24/0.18,1.60/0.34,1.96/0.20,2.32/0.36,2.68/0.20,3.35/0.23,3.85/0.20,4.35/0.24,4.85/0.20,5.35/0.24,5.85/0.20}{\fill (\x,\y) circle (0.40pt);}

  % Shelf: eta=A cos(k_1 x), with k_1 L=9 pi/2. The break value is zero,
  % as in the source trace.
  \draw[line width=0.85pt,samples=180,domain=0:\shelfL,variable=\x]
    plot (\x,{1.48+\amp*cos(\kone*\x r)});
  % Deep ocean: the amplitude is A sqrt(D_1/D_2) and the 90-degree phase
  % makes both eta and D eta_x continuous at the shelf break for ell=0.
  \draw[line width=0.85pt,samples=150,domain=\shelfL:6.00,variable=\x]
    plot (\x,{1.48+\amp*sqrt(\depthratio)*cos(\ktwo*(\x-\shelfL) r+90)});
\end{tikzpicture}
\end{center}
\smallskip
