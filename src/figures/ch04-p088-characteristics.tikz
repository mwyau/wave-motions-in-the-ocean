% wave-source: pdf=ChapmanRizzoli4.pdf; page=25; trim=85bp 420bp 70bp 235bp
% Source: Wave Motions in the Ocean, printed p.88 (physical p.25).
% Each panel retains the source's three dashed phase-line traces.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  % x-Rz=0 characteristic and the three parallel dashed phase lines.
  \begin{scope}
    \draw[->] (0.55,2.35)--(3.75,2.35) node[right] {$x$};
    \draw[->] (2.05,0.45)--(2.05,4.30) node[above] {$z$};
    \draw[line width=.75pt] (0.72,0.80)--(3.38,3.76);
    \node[anchor=west] at (2.22,3.82) {$x-Rz=0$};
    \draw[line width=.48pt,dashed] (0.54,0.56)--(3.24,3.56);
    \draw[line width=.48pt,dashed] (0.84,0.56)--(3.54,3.56);
    \draw[line width=.48pt,dashed] (0.54,1.08)--(3.24,4.08);
    \draw[->,line width=.8pt] (2.32,1.90)--(3.02,1.12) node[midway,right] {phase};
    \node[anchor=west] at (0.74,3.72) {$-$};
    \node[anchor=west] at (3.16,3.42) {$+$};
    \draw (2.05,2.92) arc[start angle=90,end angle=48,radius=.57];
    \node at (1.72,2.92) {$\phi$};
  \end{scope}

  % x+Rz=0 characteristic and its three parallel dashed phase lines.
  \begin{scope}[xshift=4.25cm]
    \draw[->] (0.55,2.35)--(3.75,2.35) node[right] {$x$};
    \draw[->] (2.05,0.45)--(2.05,4.30) node[above] {$z$};
    \draw[line width=.75pt] (0.72,3.76)--(3.38,0.80);
    \node[anchor=west] at (2.18,0.45) {$x+Rz=0$};
    \draw[line width=.48pt,dashed] (0.54,3.94)--(3.24,0.94);
    \draw[line width=.48pt,dashed] (0.84,4.08)--(3.54,1.08);
    \draw[line width=.48pt,dashed] (0.54,3.42)--(3.24,0.42);
    \draw[->,line width=.8pt] (2.32,2.60)--(3.02,3.38) node[midway,right] {phase};
    \node[anchor=west] at (0.74,3.78) {$+$};
    \node[anchor=west] at (0.74,0.96) {$-$};
    \draw (2.05,2.92) arc[start angle=90,end angle=132,radius=.57];
    \node at (2.38,2.92) {$\phi$};
  \end{scope}
\end{tikzpicture}
