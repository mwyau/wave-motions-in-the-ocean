% wave-source: pdf=ChapmanRizzoli4.pdf; page=9; trim=90bp 550bp 80bp 130bp
% Source: Wave Motions in the Ocean, printed p.72 (physical p.9), upper pair.
% k is the phase-propagation direction. The source draws the energy direction
% as a wavy arrow crossing k; its side reverses when f and N reverse.
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \def\kangle{29.407189}
  \foreach \dx/\title/\edir in {0/{$f>N$}/119.407189,5.2/{$f<N$}/-60.592811} {
    \begin{scope}[shift={(\dx,0)}]
      \node[draw,inner sep=3pt] at (1.65,2.75) {\title};
      \draw (0,-0.35)--(0,2.35);
      \draw (-0.55,0)--(3.35,0);
      \draw[->,line width=0.8pt] (0,0)--(2.75,1.55) node[right] {$\vec k$};
      \node[anchor=west] at (2.28,0.95) {(phases)};
      \draw (0,0.57) arc[start angle=90,end angle=\kangle,radius=0.57];
      \node at (0.35,0.55) {$\theta$};

      \ifdim\dx pt=0pt
        \draw[->,line width=0.70pt]
          (1.55,0.45) .. controls (1.38,0.72) and (1.62,0.86) .. (1.40,1.00)
          .. controls (1.18,1.14) and (1.43,1.27) .. (1.21,1.41)
          .. controls (0.99,1.55) and (1.22,1.68) .. (0.92,1.73);
        \node[anchor=east] at (0.87,1.69) {energy};
      \else
        \draw[->,line width=0.70pt]
          (0.92,1.73) .. controls (1.22,1.68) and (0.99,1.55) .. (1.21,1.41)
          .. controls (1.43,1.27) and (1.18,1.14) .. (1.40,1.00)
          .. controls (1.62,0.86) and (1.38,0.72) .. (1.55,0.45);
        \node[anchor=west] at (1.62,0.42) {energy};
      \fi
    \end{scope}
  }
\end{tikzpicture}
\end{center}
