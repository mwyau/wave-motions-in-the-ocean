% wave-source: pdf=ChapmanRizzoli4.pdf; page=9; trim=90bp 550bp 80bp 130bp
% Source: Wave Motions in the Ocean, printed p.72 (physical p.9), upper pair.
% k is the phase-propagation direction. Since k dot c_g=0, the energy/group-
% velocity arrow is constructed exactly perpendicular to k; its side reverses
% when the ordering of f and N reverses.
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \def\kangle{29.407189}
  \foreach \dx/\title/\edir in {0/{$f>N$}/119.407189,5.2/{$f<N$}/-60.592811} {
    \begin{scope}[shift={(\dx,0)}]
      \node[draw,inner sep=3pt] at (1.65,2.75) {\title};
      \draw (0,-0.35)--(0,2.35);
      \draw (-0.55,0)--(3.35,0);
      \draw[->,line width=0.8pt] (0,0)--(2.75,1.55) node[right] {$\vec k$};
      \node[anchor=west] at (2.28,0.95) {(phases)};
      \draw (0,0.57) arc[start angle=90,end angle=\kangle,radius=0.57];
      \node at (0.35,0.55) {$\theta$};
      \draw[->,line width=0.8pt] (1.35,0.76)--++(\edir:1.25);
      \node at ($(1.35,0.76)+(\edir:1.55)$) {energy};
      % short crest marker normal to k
      \draw[line width=0.7pt] (1.08,0.99)--(1.55,0.16);
    \end{scope}
  }
\end{tikzpicture}
\end{center}
