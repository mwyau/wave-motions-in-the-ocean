% wave-source: pdf=ChapmanRizzoli5.pdf; page=40; trim=75bp 275bp 75bp 235bp
% Source: Wave Motions in the Ocean, printed p.135 (physical p.40).
% Nondimensional geometry uses K=k sqrt(gD)/f, L=ell sqrt(gD)/f,
% Omega=sigma/f. Gravity-wave cross-sections satisfy K^2+L^2=Omega^2-1.
% For the low-frequency Rossby relation, choose B=beta sqrt(gD)/f^2=0.4
% only as a display scale; constant-Omega sections then satisfy
% (K+B/(2 Omega))^2+L^2=(B/(2 Omega))^2-1, with cutoff Omega=B/2.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=0.92cm,y=0.92cm,>=stealth,line cap=round,line join=round,font=\small]
  \def\B{0.40}
  \def\sx{1.00}
  \def\slx{0.42}
  \def\sly{0.24}
  \def\so{3.05}

  \draw[->,line width=0.8pt] (-5.25,0) -- (3.20,0) node[right] {$k$};
  \draw[->,line width=0.8pt] (0,0) -- (-2.05,-1.72) node[below left] {$-\ell$};
  \draw[->,line width=0.8pt] (0,0) -- (0,5.45) node[above] {$\sigma$};

  \foreach \om in {0.075,0.105,0.135,0.165} {
    \pgfmathsetmacro{\kc}{-\B/(2*\om)}
    \pgfmathsetmacro{\rr}{sqrt((\B/(2*\om))^2-1)}
    \draw[line width=0.55pt,samples=90,domain=0:360,variable=\t]
      plot ({\sx*(\kc+\rr*cos(\t))+\slx*(\rr*sin(\t))},
            {\so*\om+\sly*(\rr*sin(\t))});
  }
  \draw[line width=0.8pt,samples=80,domain=0.06:0.199,variable=\om]
    plot ({\sx*(-\B/(2*\om)+sqrt((\B/(2*\om))^2-1))},{\so*\om});
  \draw[line width=0.8pt,samples=80,domain=0.06:0.199,variable=\om]
    plot ({\sx*(-\B/(2*\om)-sqrt((\B/(2*\om))^2-1))},{\so*\om});
  \fill ({-\sx}, {\so*\B/2}) circle (1.2pt);
  \node[anchor=west] at (0.18,{\so*\B/2+0.16})
    {$\sigma=\dfrac{\beta\sqrt{gD}}{2f}$};
  \node[anchor=east,align=right] at (-2.55,-0.88) {Rossby wave surface};
  \node[anchor=east] at (-2.48,-1.38)
    {$\sigma=-\dfrac{\beta k}{k^2+\ell^2+f^2/gD}$};
  \fill ({\sx*(-\B/(2*0.105))},{\so*0.105}) circle (1.1pt) coordinate (Crep);
  \node[anchor=east] at (-4.10,-0.18)
    {$C\!\left(-\dfrac{\beta}{2\sigma},0\right)$};
  \draw[->,line width=0.55pt] (-3.90,-0.10) -- (Crep);

  \pgfmathsetmacro{\omtop}{1.52}
  \pgfmathsetmacro{\rg}{sqrt(\omtop*\omtop-1)}
  \draw[line width=0.8pt,samples=70,domain=1.0:\omtop,variable=\om]
    plot ({\sx*sqrt(\om*\om-1)},{\so*\om});
  \draw[line width=0.8pt,samples=70,domain=1.0:\omtop,variable=\om]
    plot ({-\sx*sqrt(\om*\om-1)},{\so*\om});
  \draw[line width=0.65pt,samples=100,domain=0:360,variable=\t]
    plot ({\sx*\rg*cos(\t)+\slx*\rg*sin(\t)},
          {\so*\omtop+\sly*\rg*sin(\t)});
  \node[anchor=west] at (1.10,4.35) {Gravity wave surface};
  \node[anchor=west] at (1.10,3.92)
    {$\sigma^2=f^2+gD(k^2+\ell^2)$};
  \node[anchor=west] at (0.10,{\so+0.02}) {$f$};
\end{tikzpicture}
\end{center}
\smallskip
