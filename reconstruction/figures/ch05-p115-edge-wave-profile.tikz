% wave-source: pdf=ChapmanRizzoli5.pdf; page=20; trim=180.00bp 459.84bp 213.12bp 235.20bp
% Source: Wave Motions in the Ocean, printed p.115 (physical p.20).
% Vector redraw of the trapped shelf-mode cross-section.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=0.95cm,y=0.95cm,line cap=round,line join=round,font=\small]
  % Stepped shelf/deep-ocean bathymetry.
  \filldraw[fill=black!15,draw=black,line width=0.75pt]
    (0,-0.12) -- (0,0.62) -- (3.25,0.62) -- (3.25,0.08) -- (6.10,0.08)
    -- (6.10,-0.12) -- cycle;
  \draw[line width=0.75pt] (0,0.62) -- (0,1.48);

  % Undisturbed sea level.
  \draw[dashed,line width=0.55pt] (0,1.48) -- (6.12,1.48);

  % Keep depth labels clear of the oscillatory elevation curve.
  \node at (1.55,0.84) {$D_1$};
  \node at (4.65,0.68) {$D_2$};

  % Equation-constrained schematic: eta=A cos(k_1 x) on the shelf and
  % eta=B exp[-k_2(x-L)] in the deep ocean. The displayed shelf wavelength is
  % schematic because the source does not specify a numerical root here.
  \draw[line width=0.85pt,samples=140,domain=0:3.25]
    plot (\x,{1.48+0.42*cos(1080*\x/3.25)});
  \draw[line width=0.85pt,samples=100,domain=3.25:5.95]
    plot (\x,{1.48+0.42*exp(-1.15*(\x-3.25))});
\end{tikzpicture}
\end{center}
\smallskip
