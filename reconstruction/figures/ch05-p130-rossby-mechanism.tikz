% wave-source: pdf=ChapmanRizzoli5.pdf; page=35; trim=91.20bp 330.24bp 59.52bp 285.60bp
% Source: Wave Motions in the Ocean, printed p.130 (physical p.35).
% For nearly zonal flow, (v_x)_t + beta v = 0. Starting from v=sin(kx),
% integration gives v_t=(beta/k) cos(kx) up to the integration constant, so a
% short time step adds a quadrature component and shifts the pattern westward.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=0.42cm,y=0.72cm,>=stealth,line cap=round,line join=round,font=\small]
  \def\xmax{18.2}
  \def\amp{0.55}

  \begin{scope}[shift={(0,5.0)}]
    \draw[->,line width=0.7pt] (0,0) -- (\xmax,0) node[right] {$x$};
    \draw[->,line width=0.7pt] (0,-0.85) -- (0,0.95) node[above] {$v$};
    \draw[line width=0.85pt,samples=180,domain=0:16.8,variable=\x]
      plot (\x,{\amp*sin(60*\x)});
    \node[anchor=west] at (19.0,0.10) {$v(x,0)=\sin(kx)$};
  \end{scope}

  \begin{scope}[shift={(0,2.5)}]
    \draw[->,line width=0.7pt] (0,0) -- (\xmax,0) node[right] {$x$};
    \draw[->,line width=0.7pt] (0,-0.85) -- (0,0.95) node[above] {$v_t$};
    \draw[line width=0.85pt,samples=180,domain=0:16.8,variable=\x]
      plot (\x,{0.50*cos(60*\x)});
    \node[anchor=west] at (19.0,0.10)
      {$\dfrac{\partial v(x,t)}{\partial t}=-\!\int\!\beta v\,dx$};
  \end{scope}

  \begin{scope}[shift={(0,0)}]
    \draw[->,line width=0.7pt] (0,0) -- (\xmax,0) node[right] {$x$};
    \draw[->,line width=0.7pt] (0,-0.85) -- (0,0.95) node[above] {$v$};
    \draw[line width=0.85pt,samples=180,domain=0:16.8,variable=\x]
      plot (\x,{\amp*sin(60*\x)+0.18*cos(60*\x)});
    \draw[->,line width=0.8pt] (3.25,1.05) -- (1.15,1.05);
    \node[anchor=west] at (19.0,0.10)
      {$v(x,t)=v(x,0)+\Delta t\,\dfrac{\partial v}{\partial t}$};
  \end{scope}
\end{tikzpicture}
\end{center}
\smallskip
