% wave-source: pdf=ChapmanRizzoli6.pdf; page=18; trim=110bp 240bp 95bp 385bp
% Source: Wave Motions in the Ocean, printed p.164 (physical p.18), lower figure.
% Schematic consequence of the derived result: increasing S raises each coastal-
% trapped-wave branch; when S max[D_x]>1 the branch reaches the inertial frequency
% omega=1 at a finite negative alongshore wavenumber and cannot continue to shorter
% wavelengths as a free subinertial wave. Curvature is schematic for arbitrary D(x).
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=1.05cm,y=1.05cm,>=stealth,line cap=round,line join=round,font=\small]
  \draw[->,line width=0.8pt] (-4.80,0) -- (1.10,0) node[right] {$\ell$};
  \draw[->,line width=0.8pt] (0,-0.10) -- (0,2.85) node[above] {$\omega$};
  \draw[dashed,line width=0.65pt] (-4.45,2.15) -- (0.30,2.15);
  \node[anchor=west] at (0.36,2.15) {$1\ (\sigma=f)$};

  % Weak stratification: branch turns over and tends toward a low short-wave limit.
  \draw[line width=0.78pt,samples=140,domain=0:4.15,variable=\q]
    plot ({-\q},{0.33*(1-exp(-1.25*\q))+0.72*\q*exp(-0.72*\q)});
  \node[anchor=north] at (-3.20,0.39) {$S\ll1$};

  % Intermediate stratification.
  \draw[line width=0.78pt,samples=125,domain=0:3.55,variable=\q]
    plot ({-\q},{0.78*(1-exp(-1.10*\q))+0.88*\q*exp(-0.78*\q)});
  \node[font=\footnotesize] at (-2.70,1.15) {$n=1$};

  % Strong stratification: draw only until the branch reaches omega=1, consistent
  % with the source statement that this is the short-wave cutoff for free waves.
  \draw[line width=0.82pt,samples=120,domain=0:2.30,variable=\q]
    plot ({-\q},{1.42*(1-exp(-1.0*\q))+0.82*\q*exp(-0.72*\q)});
  \fill (-2.30,2.13) circle (1.2pt);
  \node[anchor=south] at (-2.55,2.20) {$n=1\quad S>1$};

  \draw[->,line width=0.70pt] (-4.25,0.72) -- (-4.25,1.50);
  \node[rotate=90,anchor=south] at (-4.38,1.10) {$S$ increases};
\end{tikzpicture}
\end{center}
\smallskip
