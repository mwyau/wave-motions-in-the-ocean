% wave-source: pdf=ChapmanRizzoli4.pdf; page=14; trim=85bp 495bp 75bp 45bp
% Source: Wave Motions in the Ocean, printed p.77 (physical p.14).
% Equation-constrained classification from signs of S^2=sigma^2-f^2 and R^2.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round]
  \node[font=\bfseries] at (2.2,5.05) {$N>f$};
  \draw[->] (1.0,0.55) -- (1.0,4.75) node[above] {$\sigma$};
  \draw (0.86,1.45)--(1.14,1.45) node[left=4pt] {$f$};
  \draw (0.86,3.55)--(1.14,3.55) node[left=4pt] {$N$};
  \node[align=left,anchor=west] at (1.35,4.15) {A: $\sigma>N,f$\\$R_1^2>0$};
  \node[align=left,anchor=west] at (1.35,2.45) {B: $f<\sigma<N$\\$R^2>0$};
  \node[align=left,anchor=west] at (1.35,0.90) {A1: $\sigma<f,N$\\$R_1^2>0$};
  \node[font=\bfseries] at (6.2,5.05) {$f>N$};
  \draw[->] (5.0,0.55) -- (5.0,4.75) node[above] {$\sigma$};
  \draw (4.86,1.45)--(5.14,1.45) node[left=4pt] {$N$};
  \draw (4.86,3.55)--(5.14,3.55) node[left=4pt] {$f$};
  \node[align=left,anchor=west] at (5.35,4.15) {A: $\sigma>f,N$\\$R_1^2>0$};
  \node[align=left,anchor=west] at (5.35,2.45) {B: $N<\sigma<f$\\$R^2>0$};
  \node[align=left,anchor=west] at (5.35,0.90) {A1: $\sigma<N,f$\\$R_1^2>0$};
\end{tikzpicture}
