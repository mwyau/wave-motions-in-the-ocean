% wave-source: pdf=ChapmanRizzoli4.pdf; page=6; trim=190bp 570bp 160bp 60bp
% Source: Wave Motions in the Ocean, printed p.69 (physical p.6), upper sketch.
% For fixed sigma, m^2=R^2(k^2+ell^2), so the constant-frequency surface is a
% circular cone. At vertical coordinate m its horizontal radius is |m|/R, and
% tan(theta)=sqrt(k^2+ell^2)/m=1/R.
\par\smallskip
\begin{center}
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,line cap=round,line join=round,font=\small]
  \coordinate (O) at (0,0);
  \def\topz{3.00}
  \def\rad{0.95}

  % Projected coordinate axes.
  \draw[->,line width=0.80pt] (O) -- (0,3.75) node[above] {$m$};
  \draw[->,line width=0.80pt] (O) -- (2.35,0) node[right] {$\ell$};
  \draw[->,line width=0.80pt] (O) -- (-1.55,-1.30) node[below left] {$k$};

  % Equation-constrained cone: top ellipse is the projected circle of radius m/R.
  \draw[line width=0.80pt] (O) -- (-\rad,\topz);
  \draw[line width=0.80pt] (O) -- (\rad,\topz);
  \draw[line width=0.75pt] (0,\topz) ellipse[x radius=\rad,y radius=0.22];

  \node[anchor=west] at (0.98,3.18) {$m/R$};
  \draw[->,line width=0.55pt] (0.93,3.02) -- (0.72,3.01);

  % theta is the angle between the cone generator/wavevector and vertical m-axis.
  \draw[line width=0.55pt] (0,0.92) arc[start angle=90,end angle=72,radius=0.92];
  \node at (0.27,1.08) {$\theta$};
\end{tikzpicture}
\end{center}
\smallskip
