% wave-source: pdf=ChapmanRizzoli6.pdf; page=21; trim=105bp 335bp 90bp 300bp
% Source: Wave Motions in the Ocean, printed p.167 (physical p.21).
% Intentionally schematic family diagram. Exact constraints: ell<0 lies left of the
% origin, sigma=f is horizontal, and the strong-stratification Kelvin limit is the
% straight positive-frequency branch omega=-S ell/(n pi). CTW/CSW curve shapes are qualitative.
\begin{tikzpicture}[x=1cm,y=1cm,>=stealth,font=\small,line cap=round,line join=round]
  \coordinate (O) at (8.0,0.75);
  \draw[->] (0.65,0.75)--(9.0,0.75) node[right] {$\ell$};
  \draw[->] (O)--(8.0,5.35) node[above] {$\sigma$};
  \draw[densely dashed] (1.0,4.55)--(8.0,4.55);
  \node[anchor=west] at (8.10,4.55) {$f$};
  \draw[line width=.9pt] (1.55,1.22) .. controls (3.25,1.15) and (4.25,1.50) .. (5.05,2.10)
       .. controls (6.05,2.65) and (7.20,2.15) .. (O);
  \draw[line width=.9pt] (1.55,2.05) .. controls (3.15,2.00) and (4.15,2.32) .. (4.95,2.98)
       .. controls (5.95,3.60) and (7.15,3.05) .. (O);
  \draw[line width=.8pt] (O)--(7.35,4.35);
  \draw[line width=.8pt] (O)--(7.62,3.18);
  \node[anchor=east] at (2.1,1.30) {Continental Shelf Wave};
  \node[anchor=east] at (2.15,2.14) {Coastal-Trapped Wave};
  \node[anchor=west,align=left] at (8.22,3.55) {Baroclinic\\Kelvin Wave};
  \node at (5.35,2.50) {$n=1$};
  \node at (5.28,3.38) {$n=1$};
  \node at (7.15,4.03) {$n=1$};
\end{tikzpicture}
