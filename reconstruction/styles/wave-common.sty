\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-common}[2026/08/20 shared Wave Motions reconstruction support]

\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{mathtools}
\RequirePackage{tikz}
\usetikzlibrary{calc,decorations.pathreplacing}
\RequirePackage{graphicx}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{natbib}
\setcitestyle{authoryear}
\setlength{\bibhang}{2.5em}
\setlength{\bibsep}{0.45\baselineskip}
\RequirePackage[hidelinks,unicode,hypertexnames=false]{hyperref}
\setlength{\emergencystretch}{1.5em}
\raggedbottom

% Editorial numbering in the modern PDF and flowing reader editions. Only
% durable equations are wrapped in these environments; transient algebra remains
% unnumbered. The facsimile style suppresses these added editorial numbers.
\numberwithin{equation}{chapter}
\newenvironment{waveequation}{\begin{equation}}{\end{equation}}
\newenvironment{wavealign}{\begin{equation}\begin{aligned}}{\end{aligned}\end{equation}}
\newcommand{\wavefiguremark}{%
  \refstepcounter{figure}%
  \par\nobreak\smallskip
  \noindent\hfill{\small\sffamily Figure \thefigure}\hfill\null\par
  \smallskip
}

% Build identity is generated under build/ so source files remain stable. A
% direct TeX compile without the repository build wrapper falls back cleanly.
\IfFileExists{../build/build-info.tex}{%
  \input{../build/build-info.tex}%
}{%
  \providecommand{\wavebuildsha}{unknown}%
  \providecommand{\wavebuildshort}{unknown}%
  \providecommand{\wavebuildversion}{}%
  \providecommand{\wavebuildlabel}{unknown}%
  \providecommand{\wavebuildurl}{https://github.com/mwyau/wave-motions-in-the-ocean}%
}
\AtBeginDocument{%
  \hypersetup{%
    pdfsubject={Digital edition build \wavebuildlabel},%
    pdfkeywords={Wave Motions in the Ocean, digital edition, build \wavebuildshort}%
  }%
}

% Consistent attribution block for modern front matter. Keep the semantic
% order name / place, year so the HTML conversion can mirror it exactly.
\newcommand{\wavesignature}[3]{%
  \par\medskip
  \begin{flushright}
    \textit{#1}\\
    #2, #3
  \end{flushright}
}

% Direct crop from an authoritative committed source PDF. Arguments are
% width fraction, source filename, physical PDF page, and trim rectangle.
\newcommand{\sourceart}[4][0.72]{%
  \par\smallskip
  \begin{center}
    \includegraphics[page=#3,trim=#4,clip,width=#1\linewidth]{../source/#2}%
  \end{center}
  \wavefiguremark
  \smallskip
}

% Explicit vector reconstruction. The requested width scales only the geometric
% TikZ coordinate system. Labels keep one physical \small size, and line weights
% and arrowheads are not silently magnified or shrunk with the figure width.
% The small safety factor leaves room for unscaled text at the picture boundary.
\newsavebox{\wavevectorbox}
\makeatletter
\newcommand{\wavevectorart}[2][0.72]{%
  \par\smallskip
  \begin{center}
    \begingroup
      \let\par\relax
      \let\smallskip\relax
      \def\center{}%
      \def\endcenter{}%
      \sbox{\wavevectorbox}{%
        \begingroup
          \small
          \input{figures/#2.tikz}%
        \endgroup
      }%
      \pgfmathsetmacro{\wavevectorscale}{%
        0.975*(#1*\strip@pt\linewidth)/(\strip@pt\wd\wavevectorbox)%
      }%
      \tikzset{every picture/.append style={scale=\wavevectorscale}}%
      \small
      \input{figures/#2.tikz}%
    \endgroup
  \end{center}
  \wavefiguremark
  \smallskip
}
\makeatother

% Use a stable heading name in PDF and HTML bibliography output.
\renewcommand{\bibname}{References}
