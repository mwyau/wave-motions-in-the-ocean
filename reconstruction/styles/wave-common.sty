\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-common}[2026/08/20 shared Wave Motions reconstruction support]

\RequirePackage[T1]{fontenc}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{mathtools}
\RequirePackage{tikz}
\usetikzlibrary{calc,decorations.pathreplacing}
\RequirePackage{graphicx}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{natbib}
\setcitestyle{authoryear}
\setlength{\bibhang}{2.5em}
\setlength{\bibsep}{0.45\baselineskip}
\RequirePackage[hidelinks,unicode,hypertexnames=false]{hyperref}
\setlength{\emergencystretch}{1.5em}
\raggedbottom

% Build identity is generated under build/ so source files remain stable. A
% direct TeX compile without the repository build wrapper falls back cleanly.
\IfFileExists{../build/build-info.tex}{%
  \input{../build/build-info.tex}%
}{%
  \providecommand{\wavebuildsha}{unknown}%
  \providecommand{\wavebuildshort}{unknown}%
  \providecommand{\wavebuildversion}{}%
  \providecommand{\wavebuildlabel}{unknown}%
  \providecommand{\wavebuildurl}{https://github.com/mwyau/wave-motions-in-the-ocean}%
}
\AtBeginDocument{%
  \hypersetup{%
    pdfsubject={Digital edition build \wavebuildlabel},%
    pdfkeywords={Wave Motions in the Ocean, digital edition, build \wavebuildshort}%
  }%
}

% Consistent attribution block for modern front matter. Keep the semantic
% order name / place, year so the HTML conversion can mirror it exactly.
\newcommand{\wavesignature}[3]{%
  \par\medskip
  \begin{flushright}
    \textit{#1}\\
    #2, #3
  \end{flushright}
}

% Direct crop from an authoritative committed source PDF. Arguments are
% width fraction, source filename, physical PDF page, and trim rectangle.
\newcommand{\sourceart}[4][0.72]{%
  \par\smallskip
  \begin{center}
    \includegraphics[page=#3,trim=#4,clip,width=#1\linewidth]{../source/#2}%
  \end{center}
  \smallskip
}

% Explicit vector reconstruction. This is intentionally not a replacement
% registry: the chapter names the vector file directly.
\newcommand{\wavevectorart}[2][0.72]{%
  \par\smallskip
  \begin{center}
    \begingroup
      \let\par\relax
      \let\smallskip\relax
      \def\center{}%
      \def\endcenter{}%
      \resizebox{#1\linewidth}{!}{\input{figures/#2.tikz}}%
    \endgroup
  \end{center}
  \smallskip
}

% Use a stable heading name in PDF and HTML bibliography output.
\renewcommand{\bibname}{References}
