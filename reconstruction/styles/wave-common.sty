\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-common}[2026/08/21 shared LuaLaTeX/STIX Two reconstruction support]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{fontspec}
\RequirePackage{microtype}
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}
\setmainfont{STIX Two Text}[Ligatures=TeX]
\setsansfont{Source Sans 3}[Ligatures=TeX,Scale=0.94]
\setmathfont{STIX Two Math}
\RequirePackage{tikz}
\usetikzlibrary{calc,decorations.pathreplacing}
\RequirePackage{graphicx}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{natbib}
\setcitestyle{authoryear}
\setlength{\bibhang}{2.5em}
\setlength{\bibsep}{0.45\baselineskip}
\RequirePackage[hidelinks,unicode,hypertexnames=false]{hyperref}
\setlength{\emergencystretch}{1.5em}

% Durable equations receive editorial numbering in the modern and flowing
% editions; the facsimile style suppresses that numbering.
\numberwithin{equation}{chapter}
\NewDocumentEnvironment{waveequation}{}{\begin{equation}}{\end{equation}}
\NewDocumentEnvironment{wavealign}{}{\begin{equation}\begin{aligned}}{\end{aligned}\end{equation}}
\NewDocumentCommand{\wavefiguremark}{}{%
	\refstepcounter{figure}%
	\par\nobreak\smallskip
	\noindent\hfill{\small\sffamily Figure \thefigure}\hfill\null\par
	\smallskip
}

% Source-page counters are provenance. Flowing editions ignore them; the
% facsimile style gives this command page-boundary semantics.
\NewDocumentCommand{\sourcesetpage}{m}{}

% Build identity is generated under build/ while direct TeX compilation remains
% usable without the repository build wrapper.
\IfFileExists{../build/build-info.tex}{%
	\input{../build/build-info.tex}%
}{%
	\providecommand{\wavebuildsha}{unknown}%
	\providecommand{\wavebuildshort}{unknown}%
	\providecommand{\wavebuildversion}{}%
	\providecommand{\wavebuildlabel}{unknown}%
	\providecommand{\wavebuildurl}{https://github.com/mwyau/wave-motions-in-the-ocean}%
}
\AtBeginDocument{%
	\hypersetup{%
		pdfsubject={Digital edition build \wavebuildlabel},%
		pdfkeywords={Wave Motions in the Ocean, digital edition, build \wavebuildshort}%
	}%
}

% Shared semantic markup also drives generated HTML/EPUB transformations.
\NewDocumentCommand{\wavesignature}{m m m}{%
	\par\medskip
	\begin{flushright}
		\textit{#1}\\
		#2, #3
	\end{flushright}
}

% Direct crop from an authoritative source PDF: width, filename, physical page,
% and trim rectangle.
\NewDocumentCommand{\sourceart}{O{0.72} m m m}{%
	\par\smallskip
	\begin{center}
		\includegraphics[page=#3,trim=#4,clip,width=#1\linewidth]{../source/#2}%
	\end{center}
	\wavefiguremark
	\smallskip
}

% The requested width scales only TikZ geometry. Labels retain one physical
% \small size, and line weights/arrowheads are not scaled with the picture.
\newsavebox{\wavevectorbox}
\makeatletter
\NewDocumentCommand{\wavevectorart}{O{0.72} m}{%
	\par\smallskip
	\begin{center}
		\begingroup
		\let\par\relax
		\let\smallskip\relax
		\def\center{}%
		\def\endcenter{}%
		\sbox{\wavevectorbox}{%
			\begingroup
			\small
			\input{figures/#2.tikz}%
			\endgroup
		}%
		\pgfmathsetmacro{\wavevectorscale}{%
			0.975*(#1*\strip@pt\linewidth)/(\strip@pt\wd\wavevectorbox)%
		}%
		\tikzset{every picture/.append style={scale=\wavevectorscale}}%
		\small
		\input{figures/#2.tikz}%
		\endgroup
	\end{center}
	\wavefiguremark
	\smallskip
}
\makeatother

\renewcommand{\bibname}{References}
