\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-facsimile}[2026/08/21 source-page facsimile layout]
\RequirePackage{styles/wave-common}

% Preserve the 12 pt reading size while keeping enough uniform vertical reserve
% for every historical source page. Page fit is controlled globally rather than
% with page-specific figure or crop exceptions.
\RequirePackage[letterpaper,top=0.80in,bottom=0.50in,left=0.95in,right=0.95in]{geometry}
\RequirePackage{lmodern}

% Preserve the historical source-page edition: suppress modern editorial
% equation/figure numbering while keeping the shared canonical source unchanged.
\renewenvironment{waveequation}{\begin{equation*}}{\end{equation*}}
\renewenvironment{wavealign}{\begin{equation*}\begin{aligned}}{\end{aligned}\end{equation*}}
\renewcommand{\wavefiguremark}{}

% Figure placements use one compact facsimile spacing policy. The requested
% figure scale and crop remain untouched; only surrounding vertical whitespace
% is reduced uniformly on every source page.
\newcommand{\WaveFacsimileFigureSpacing}{%
  \setlength{\smallskipamount}{1.5pt plus 0.5pt minus 0.5pt}%
  \setlength{\topsep}{2pt plus 1pt minus 1pt}%
  \setlength{\partopsep}{0pt}%
}
\NewCommandCopy\WaveFacsimileSourceArt\sourceart
\renewcommand{\sourceart}[4][0.72]{%
  \begingroup
    \WaveFacsimileFigureSpacing
    \WaveFacsimileSourceArt[#1]{#2}{#3}{#4}%
  \endgroup
}
\NewCommandCopy\WaveFacsimileVectorArt\wavevectorart
\renewcommand{\wavevectorart}[2][0.72]{%
  \begingroup
    \WaveFacsimileFigureSpacing
    \WaveFacsimileVectorArt[#1]{#2}%
  \endgroup
}

\setlength{\parindent}{1.75em}
\setlength{\parskip}{0pt}
\setlength{\jot}{5pt}
\pagestyle{plain}
\flushbottom

\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{1.45in}%
  {\parindent\z@\raggedright\normalfont
   \Large Chapter \thechapter\par
   \vspace{0.52in}%
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.70in}}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{1.20in}%
  {\parindent\z@\raggedright\normalfont
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.65in}}}
\makeatother

\AtBeginDocument{%
  % Chapter/section machinery calls \normalsize, so make the facsimile reading
  % size durable. Sparse source pages may stretch modestly under \flushbottom;
  % dense pages use the 12.7 pt minimum leading.
  \let\WaveClassNormalSize\normalsize
  \renewcommand{\normalsize}{%
    \WaveClassNormalSize
    \fontsize{12.0pt}{12.7pt}\selectfont
    \setlength{\baselineskip}{12.7pt plus 6.0pt minus 0.4pt}%
    \setlength{\abovedisplayskip}{9pt plus 2pt minus 3pt}%
    \setlength{\belowdisplayskip}{9pt plus 2pt minus 3pt}%
    \setlength{\abovedisplayshortskip}{6pt plus 2pt minus 2pt}%
    \setlength{\belowdisplayshortskip}{6pt plus 2pt minus 2pt}%
  }%
  \normalsize
}

% Unlike \clearpage/\newpage, \pagebreak lets \flushbottom use the stretchable
% leading above to fill a sparse historical source page.
\newcommand{\sourcepagebreak}{\par\pagebreak[4]}
\newcommand{\sourceinput}[1]{\input{#1}\clearpage}

% Fragment files retain historical page-counter resets. A reset encountered
% after material has begun is also a source-page boundary; break first so
% independently reconstructed fragments cannot merge two source pages.
\makeatletter
\let\WaveFacsimileOriginalSetCounter\setcounter
\newcommand{\WaveFacsimileSetCounter}[2]{%
  \def\WaveFacsimileCounterName{#1}%
  \def\WaveFacsimilePageCounter{page}%
  \ifx\WaveFacsimileCounterName\WaveFacsimilePageCounter
    \ifdim\pagetotal>0pt\relax
      \par\pagebreak[4]%
    \fi
  \fi
  \WaveFacsimileOriginalSetCounter{#1}{#2}%
}
\AtBeginDocument{\let\setcounter\WaveFacsimileSetCounter}
\makeatother
