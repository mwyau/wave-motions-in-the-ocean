\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-facsimile}[2026/08/21 source-page facsimile layout]
\RequirePackage{styles/wave-common}
\RequirePackage[letterpaper,top=0.76in,bottom=0.46in,left=0.95in,right=0.95in]{geometry}
\RequirePackage{setspace}

% The facsimile preserves historical source-page structure and suppresses
% editorial equation/figure numbering added for the modern edition.
\RenewDocumentEnvironment{waveequation}{}{\begin{equation*}}{\end{equation*}}
\RenewDocumentEnvironment{wavealign}{}{\begin{equation*}\begin{aligned}}{\end{aligned}\end{equation*}}
\RenewDocumentCommand{\wavefiguremark}{}{}

\setlength{\parindent}{1.75em}
\setlength{\parskip}{0pt}
\pagestyle{plain}
\flushbottom

\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{1.45in}%
  {\parindent\z@\raggedright\normalfont
   \Large Chapter \thechapter\par
   \vspace{0.52in}%
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.70in}}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{1.20in}%
  {\parindent\z@\raggedright\normalfont
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.65in}}}
\makeatother

\AtBeginDocument{%
  % The class resets list spacing through \normalsize; reapply the complete
  % facsimile rhythm there so every source page follows one global policy.
  \let\WaveClassNormalSize\normalsize
  \renewcommand{\normalsize}{%
    \WaveClassNormalSize
    \fontsize{12.0pt}{12.6pt}\selectfont
    \setlength{\baselineskip}{12.6pt plus 5.5pt minus 0.4pt}%
    \setlength{\smallskipamount}{1pt plus 0.25pt minus 0.25pt}%
    \setlength{\topsep}{1.5pt plus 0.5pt minus 0.5pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\jot}{4.5pt}%
    \setlength{\abovedisplayskip}{8.5pt plus 2pt minus 3pt}%
    \setlength{\belowdisplayskip}{8.5pt plus 2pt minus 3pt}%
    \setlength{\abovedisplayshortskip}{5.5pt plus 2pt minus 2pt}%
    \setlength{\belowdisplayshortskip}{5.5pt plus 2pt minus 2pt}%
  }%
  \normalsize
}

% \pagebreak lets \flushbottom use stretchable leading to fill sparse source
% pages without changing the historical figure scales or crop geometry.
\NewDocumentCommand{\sourcepagebreak}{}{\par\pagebreak[4]}
\NewDocumentCommand{\sourceinput}{m}{\input{#1}\clearpage}

% A source-page reset is also a boundary when material is already present.
\RenewDocumentCommand{\sourcesetpage}{m}{%
  \ifdim\pagetotal>0pt\relax
    \par\pagebreak[4]%
  \fi
  \setcounter{page}{#1}%
}
