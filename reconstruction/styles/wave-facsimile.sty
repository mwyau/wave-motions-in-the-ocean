\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-facsimile}[2026/08/20 source-page facsimile layout]
\RequirePackage{styles/wave-common}
% Keep the 12 pt type and open leading while giving dense historical pages
% slightly more usable vertical room. This preserves the source-page boundaries
% without shrinking the reading size or allowing content to spill to page 185.
\RequirePackage[letterpaper,top=0.80in,bottom=0.50in,left=0.95in,right=0.95in]{geometry}
\RequirePackage{lmodern}

% Preserve the historical source-page edition: the canonical source carries
% modern editorial numbering semantics, but the facsimile renders the original
% unnumbered display/figure presentation. Keep the alignment body inside a
% matching outer environment so LaTeX does not see mismatched environment names.
\renewenvironment{waveequation}{\begin{equation*}}{\end{equation*}}
\renewenvironment{wavealign}{\begin{equation*}\begin{aligned}}{\end{aligned}\end{equation*}}
\renewcommand{\wavefiguremark}{}

% Two dense source pages need facsimile-only presentation adjustments. Keep the
% shared chapter source and flowing editions unchanged: p.84 needs the validated
% vector at the source-page scale, while the p.161 source crop must omit prose
% already reconstructed immediately above it.
\NewCommandCopy\WaveFacsimileOriginalVectorArt\wavevectorart
\renewcommand{\wavevectorart}[2][0.72]{%
  \def\WaveFacsimileFigureName{#2}%
  \def\WaveFacsimileCompactFigure{ch04-p084-evanescent-case-b}%
  \ifx\WaveFacsimileFigureName\WaveFacsimileCompactFigure
    \WaveFacsimileOriginalVectorArt[0.66]{#2}%
  \else
    \WaveFacsimileOriginalVectorArt[#1]{#2}%
  \fi
}

\NewCommandCopy\WaveFacsimileOriginalSourceArt\sourceart
\renewcommand{\sourceart}[4][0.72]{%
  \def\WaveFacsimileSourceFile{#2}%
  \def\WaveFacsimileShelfWaveSource{ChapmanRizzoli6.pdf}%
  \def\WaveFacsimileSourcePage{#3}%
  \def\WaveFacsimileShelfWavePage{15}%
  \ifx\WaveFacsimileSourceFile\WaveFacsimileShelfWaveSource
    \ifx\WaveFacsimileSourcePage\WaveFacsimileShelfWavePage
      \WaveFacsimileOriginalSourceArt[#1]{#2}{#3}{105bp 325bp 85bp 290bp}%
    \else
      \WaveFacsimileOriginalSourceArt[#1]{#2}{#3}{#4}%
    \fi
  \else
    \WaveFacsimileOriginalSourceArt[#1]{#2}{#3}{#4}%
  \fi
}

\setlength{\parindent}{1.75em}
\setlength{\parskip}{0pt}
\setlength{\jot}{6pt}
\pagestyle{plain}
\flushbottom

\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{1.45in}%
  {\parindent\z@\raggedright\normalfont
   \Large Chapter \thechapter\par
   \vspace{0.52in}%
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.70in}}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{1.20in}%
  {\parindent\z@\raggedright\normalfont
   \LARGE\bfseries #1\par\nobreak
   \vspace{0.65in}}}
\makeatother

\AtBeginDocument{%
  % Make the custom reading size durable: chapter/section machinery calls
  % \normalsize, so setting \fontsize only once would silently revert later.
  \let\WaveClassNormalSize\normalsize
  \renewcommand{\normalsize}{%
    \WaveClassNormalSize
    % The source is unusually open-set. Keep a readable 12 pt floor, then let
    % sparse source pages stretch the interline glue instead of leaving a large
    % dead area at the bottom. Dense pages remain close to the 13.2 pt minimum.
    \fontsize{12.0pt}{13.2pt}\selectfont
    \setlength{\baselineskip}{13.2pt plus 7.0pt minus 0.4pt}%
    \setlength{\abovedisplayskip}{10pt plus 2pt minus 3pt}%
    \setlength{\belowdisplayskip}{10pt plus 2pt minus 3pt}%
    \setlength{\abovedisplayshortskip}{7pt plus 2pt minus 2pt}%
    \setlength{\belowdisplayshortskip}{7pt plus 2pt minus 2pt}%
  }%
  \normalsize
}

% Unlike \clearpage/\newpage, \pagebreak lets \flushbottom use the
% stretchable leading above to fill a sparse historical source page.
\newcommand{\sourcepagebreak}{\par\pagebreak[4]}
\newcommand{\sourceinput}[1]{\input{#1}\clearpage}

% Fragment files retain historical page-counter resets. A reset encountered
% after material has begun is also a source-page boundary; break first so
% independently reconstructed fragments cannot merge two source pages.
\makeatletter
\let\WaveFacsimileOriginalSetCounter\setcounter
\newcommand{\WaveFacsimileSetCounter}[2]{%
  \def\WaveFacsimileCounterName{#1}%
  \def\WaveFacsimilePageCounter{page}%
  \ifx\WaveFacsimileCounterName\WaveFacsimilePageCounter
    \ifdim\pagetotal>0pt\relax
      \par\pagebreak[4]%
    \fi
  \fi
  \WaveFacsimileOriginalSetCounter{#1}{#2}%
}
\AtBeginDocument{\let\setcounter\WaveFacsimileSetCounter}
\makeatother
