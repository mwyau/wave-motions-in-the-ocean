\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/wave-modern}[2026/08/20 continuous modern reading layout]
\RequirePackage{styles/wave-common}
\RequirePackage[letterpaper,top=0.70in,bottom=0.72in,left=0.82in,right=0.82in,headsep=0.22in]{geometry}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage[scaled=0.94]{sourcesanspro}
\RequirePackage{titlesec}

\definecolor{WaveAccent}{HTML}{245A73}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0.18em plus 0.05em minus 0.03em}
\setlength{\jot}{7pt}
\setlength{\headheight}{22pt}

\titleformat{\chapter}[display]
  {\normalfont\sffamily\color{WaveAccent}}
  {\Large\bfseries Chapter \thechapter}
  {0.32em}
  {\Huge\bfseries}
  [\vspace{0.25em}\titlerule]
\titlespacing*{\chapter}{0pt}{0.2in}{0.38in}
\titleformat{\section}
  {\Large\sffamily\bfseries\color{WaveAccent}}
  {\thesection}{0.65em}{}
\titlespacing*{\section}{0pt}{1.25em plus .2em minus .1em}{0.50em}
\titleformat{\subsection}
  {\large\sffamily\bfseries\color{WaveAccent}}
  {\thesubsection}{0.55em}{}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{WaveAccent} Wave Motions in the Ocean}
\fancyhead[R]{\small\sffamily\color{WaveAccent}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{WaveAccent}\leaders\hrule height \headrulewidth\hfill}}

\AtBeginDocument{%
  % Keep the modern reading size after chapter/section commands invoke
  % \normalsize; a one-time \fontsize assignment is not sufficient.
  \let\WaveClassNormalSize\normalsize
  \renewcommand{\normalsize}{%
    \WaveClassNormalSize
    \fontsize{11.5pt}{14.2pt}\selectfont
    \setlength{\abovedisplayskip}{11pt plus 3pt minus 3pt}%
    \setlength{\belowdisplayskip}{11pt plus 3pt minus 3pt}%
    \setlength{\abovedisplayshortskip}{8pt plus 2pt minus 2pt}%
    \setlength{\belowdisplayshortskip}{8pt plus 2pt minus 2pt}%
  }%
  \normalsize
}

\newcommand{\sourcepagebreak}{\par}
\newcommand{\sourceinput}[1]{\input{#1}}

% Source fragments retain historical page counter resets as provenance. Ignore
% only those page resets in the modern continuous edition. Modern front/main
% matter still needs deliberate page-numbering resets, so expose a dedicated
% wrapper that temporarily restores the class's original \setcounter.
\makeatletter
\let\WaveOriginalSetCounter\setcounter
\newcommand{\WaveModernSetCounter}[2]{%
  \def\WaveCounterName{#1}%
  \def\WavePageCounter{page}%
  \ifx\WaveCounterName\WavePageCounter
  \else
    \WaveOriginalSetCounter{#1}{#2}%
  \fi}
\renewcommand{\setcounter}[2]{\WaveModernSetCounter{#1}{#2}}
\newcommand{\wavepagenumbering}[1]{%
  \let\setcounter\WaveOriginalSetCounter
  \pagenumbering{#1}%
  \let\setcounter\WaveModernSetCounter
}
\makeatother
